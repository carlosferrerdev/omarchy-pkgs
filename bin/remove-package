#!/bin/bash
set -e

unset GPG_PRIVATE_KEY GPG_PASSPHRASE

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/lock-helpers.sh"

print_header "Remove Package"

# Parse arguments
PACKAGE_NAME=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch)
    ARCH="$2"
    update_arch_paths
    shift 2
    ;;
  --mirror)
    MIRROR="$2"
    require_valid_mirror "$MIRROR"
    update_arch_paths
    shift 2
    ;;
  -h | --help)
    echo "Usage: $0 <package-name> [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --arch <arch>      Target architecture (x86_64 or aarch64, default: x86_64)"
    echo "  --mirror <mirror>  Mirror to use (edge, rc, or stable, default: edge)"
    echo "  -h, --help         Show this help message"
    exit 0
    ;;
  *)
    if [[ -z "$PACKAGE_NAME" ]]; then
      PACKAGE_NAME="$1"
    else
      print_error "Unknown option: $1"
      exit 1
    fi
    shift
    ;;
  esac
done

if [[ -z "$PACKAGE_NAME" ]]; then
  print_error "Package name required"
  echo ""
  echo "Usage: $0 <package-name> [OPTIONS]"
  exit 1
fi
if [[ ! $PACKAGE_NAME =~ ^[A-Za-z0-9@._+:-]+$ ]]; then
  print_error "Invalid package name: $PACKAGE_NAME"
  exit 1
fi

print_info "Target architecture: $ARCH"
print_info "Mirror: $MIRROR"
print_info "Repository: $REPO_DIR"

# Check if repository exists
if [[ ! -d "$REPO_DIR" ]]; then
  print_error "Repository directory not found: $REPO_DIR"
  exit 1
fi

command -v bsdtar >/dev/null 2>&1 || {
  print_error "bsdtar is required to identify repository packages"
  exit 1
}

MATCHED_FILES=()
find_package_files() {
  local candidate identity signature
  MATCHED_FILES=()
  shopt -s nullglob
  for candidate in "$REPO_DIR"/*.pkg.tar.*; do
    [[ $candidate == *.sig ]] && continue
    [[ -f $candidate && ! -L $candidate ]] || continue
    identity=$(bsdtar -xOf "$candidate" .PKGINFO 2>/dev/null |
      awk -F ' = ' '$1 == "pkgname" { count++; name=$2 } END { if (count == 1) print name }')
    [[ $identity == "$PACKAGE_NAME" ]] || continue
    signature="$candidate.sig"
    [[ -f $signature && ! -L $signature ]] || {
      print_error "Package has no regular detached signature: ${candidate##*/}"
      shopt -u nullglob
      return 1
    }
    MATCHED_FILES+=("$candidate" "$signature")
  done
  shopt -u nullglob
}

find_package_files
if [[ ${#MATCHED_FILES[@]} -eq 0 ]]; then
  print_error "Package '$PACKAGE_NAME' not found"
  exit 1
fi

# Confirm removal
echo ""
echo "Package files to remove:"
for file in "${MATCHED_FILES[@]}"; do
  echo "  - ${file##*/}"
done
echo ""
read -p "Remove package '$PACKAGE_NAME'? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  print_info "Removal cancelled"
  exit 0
fi

acquire_release_lock || exit 1
find_package_files
[[ ${#MATCHED_FILES[@]} -gt 0 ]] || {
  print_error "Package changed or disappeared while acquiring the release lock"
  exit 1
}

REMOVAL_STAGE=$(mktemp -d "$REPO_DIR/.omarchy-remove-stage.XXXXXX")
chmod 0700 "$REMOVAL_STAGE"
REMOVAL_COMMITTED=false
restore_staged_files() {
  [[ $REMOVAL_COMMITTED == false && -d $REMOVAL_STAGE && ! -L $REMOVAL_STAGE ]] || return 0
  for file in "$REMOVAL_STAGE"/*; do
    [[ -e $file || -L $file ]] || continue
    mv -- "$file" "$REPO_DIR/${file##*/}"
  done
  rmdir "$REMOVAL_STAGE" 2>/dev/null || true
}
trap restore_staged_files EXIT

print_info "Staging package removal..."
for file in "${MATCHED_FILES[@]}"; do
  mv -- "$file" "$REMOVAL_STAGE/${file##*/}"
done

# update-repo builds and signs a fresh immutable database generation. If any
# step fails, the EXIT trap restores the package/signature pair and the previous
# canonical generation remains active.
if ! "$BUILD_ROOT/bin/update-repo" --arch "$ARCH" --mirror "$MIRROR"; then
  print_error "Signed database update failed; restoring staged package files"
  exit 1
fi

REMOVAL_COMMITTED=true
rm -rf -- "$REMOVAL_STAGE"
trap - EXIT
RESULT=0

echo ""
if [[ $RESULT -eq 0 ]]; then
  print_success "Package removal completed successfully!"
else
  print_error "Package removal failed"
  exit $RESULT
fi
