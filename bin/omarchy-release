#!/bin/bash
# omarchy-release — the front door for cutting Omarchy releases.
#
# A release train has three human moments, each one command:
#   start  open the train: release branch + staging PR (+ advance edge -> rc)
#   rc     cut a candidate: pin PKGBUILDs to the branch head, publish to rc
#   ship   make it official: final pins, promote rc -> stable, tag, GH release,
#          ISO, website
#
# Run bare `omarchy-release` to be shepherded: it observes reality (branches,
# pins, published channels, tags) and offers the correct next step. Every
# subcommand is idempotent — a re-run checks what is already done and skips it.
#
# Versions are inferred from branch names: branch v4-0-2 -> RCs 4.0.2rcN ->
# tag v4.0.2. `start` is the only place a version is typed.

set -e

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/host-helpers.sh"
source "$BUILD_ROOT/helpers/publish-helpers.sh"

UPSTREAM_URL="${OMARCHY_UPSTREAM_URL:-https://github.com/carlosferrerdev/prumo.git}"
UPSTREAM_REPO="${OMARCHY_UPSTREAM_REPO:-carlosferrerdev/prumo}"
PKGS_ORIGIN="${OMARCHY_PKGS_ORIGIN:-}"
SITE_REPO="${OMARCHY_SITE_REPO:-}"
ISO_REPO="${OMARCHY_ISO_REPO:-}"
ISO_BRANCH="${OMARCHY_ISO_BRANCH:-quattro}"
ISO_RCLONE_DEST="${OMARCHY_ISO_RCLONE_DEST:-}"
PKGS_RCLONE_DEST="${OMARCHY_PKGS_RCLONE_DEST:-}"
DEV_BRANCH="${OMARCHY_DEV_BRANCH:-gnome}"

PKGS_DB_BASE="${OMARCHY_PKGS_DB_BASE:-}"
RC_DB_URL="${PKGS_DB_BASE:+$PKGS_DB_BASE/rc/x86_64/omarchy.db.tar.zst}"

SRCDEST_DIR="$BUILD_ROOT/.srcdest"
MIRROR_CLONE="$SRCDEST_DIR/omarchy"          # bare mirror (shared with bin/omarchy-pkgs)
WORK_CLONE="$SRCDEST_DIR/omarchy-work"       # working clone for pick/cherry-pick
RC_WORKTREE="$BUILD_ROOT/.worktrees/rc"      # pkgs repo rc branch worktree

ASSUME_YES=false
REPO_HOST_OVERRIDE=""

require_release_config() {
  local push_url canonical_pkgs normalized_pkgs normalized_iso normalized_site
  local db_authority db_host missing=()
  local push_urls=()
  [[ -n "$PKGS_ORIGIN" ]] || missing+=(OMARCHY_PKGS_ORIGIN)
  [[ -n "$PKGS_DB_BASE" ]] || missing+=(OMARCHY_PKGS_DB_BASE)
  [[ -n "$SITE_REPO" ]] || missing+=(OMARCHY_SITE_REPO)
  [[ -n "$ISO_REPO" ]] || missing+=(OMARCHY_ISO_REPO)
  [[ -n "$ISO_RCLONE_DEST" ]] || missing+=(OMARCHY_ISO_RCLONE_DEST)
  [[ -n "$PKGS_RCLONE_DEST" ]] || missing+=(OMARCHY_PKGS_RCLONE_DEST)
  if (( ${#missing[@]} > 0 )); then
    print_error "Gomarchy release infrastructure is not fully configured"
    print_error "Set: ${missing[*]}"
    print_error "Refusing to inherit any Omarchy production destination"
    exit 1
  fi
  package_publish_destination "$PKGS_RCLONE_DEST" >/dev/null || exit 1
  if [[ ! "$PKGS_DB_BASE" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]]; then
    print_error "OMARCHY_PKGS_DB_BASE must be a Gomarchy-owned HTTPS base URL"
    exit 1
  fi
  db_authority=${PKGS_DB_BASE#https://}
  db_authority=${db_authority%%/*}
  db_host=${db_authority%%:*}
  db_host=$(tr '[:upper:]' '[:lower:]' <<<"$db_host") || exit 1
  if [[ "$db_host" == "pkgs.omarchy.org" ]]; then
    print_error "Refusing the upstream Omarchy package database"
    exit 1
  fi
  [[ "$ISO_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    print_error "Invalid OMARCHY_ISO_REPO: $ISO_REPO"
    exit 1
  }
  [[ "$SITE_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    print_error "Invalid OMARCHY_SITE_REPO: $SITE_REPO"
    exit 1
  }
  normalized_iso=$(tr '[:upper:]' '[:lower:]' <<<"$ISO_REPO") || exit 1
  normalized_site=$(tr '[:upper:]' '[:lower:]' <<<"$SITE_REPO") || exit 1
  if [[ "$normalized_iso" == "omacom/omarchy-iso" || "$normalized_site" == omacom/* ]]; then
    print_error "Refusing an upstream Omarchy ISO or website repository"
    exit 1
  fi
  iso_publish_destination "$ISO_RCLONE_DEST" >/dev/null || exit 1
  canonical_pkgs=$(canonical_github_repo "$PKGS_ORIGIN") || {
    print_error "OMARCHY_PKGS_ORIGIN must be a canonical GitHub repository URL"
    exit 1
  }
  normalized_pkgs=$(tr '[:upper:]' '[:lower:]' <<<"$canonical_pkgs") || exit 1
  if [[ "$normalized_pkgs" == "omacom/omarchy-pkgs" ]]; then
    print_error "Refusing the upstream Omarchy package Git repository"
    exit 1
  fi

  while IFS= read -r push_url; do
    [[ -n "$push_url" ]] && push_urls+=("$push_url")
  done < <(git -C "$BUILD_ROOT" remote get-url --push --all origin 2>/dev/null || true)
  if (( ${#push_urls[@]} != 1 )) || [[ "${push_urls[0]:-}" != "$PKGS_ORIGIN" ]]; then
    print_error "Package push origin mismatch: expected exactly '$PKGS_ORIGIN'"
    print_error "Found ${#push_urls[@]} push destination(s): ${push_urls[*]:-<none>}"
    print_error "Refusing to mutate release state in an unverified repository"
    exit 1
  fi
}

show_usage() {
  cat <<EOF
Usage: $0 [command] [options]

Run with no command to be shepherded through whatever the next step is.

Commands:
  start [X.Y.Z]      Open a release train: create branch v X-Y-Z on $UPSTREAM_REPO
                     (from the previous tag for a patch, from $DEV_BRANCH for a
                     minor/major), open the release-notes staging PR, and for a
                     minor/major advance edge -> rc on the build host
  pick [pr#|sha ...] Cherry-pick merged PRs onto the release branch; with no
                     args, choose from a list of merged $DEV_BRANCH PRs
  rc                 Cut the next X.Y.ZrcN into the rc channel
  ship               Final pins, promote rc -> stable, tag, GitHub release,
                     ISO (prompted), website bump
  status             Show where the train stands (read-only)
  doctor             Verify every credential and connection the flow needs
  self-test          Run helper unit tests

Options:
  --yes              Skip confirmation prompts (for scripting/CI)
  --host <host>      Build host ssh destination (else \$OMARCHY_REPO_HOST or .repo-host)
  --iso / --no-iso   (rc, ship) Build the ISO without asking / explicitly waive it
  --resume-site      (ship) Verify an already-published ISO, then update only the site
  --no-wait          (rc, ship) Queue a needed build, then stop before promotion
                     (incompatible with --iso)
  -h, --help         Show this help
EOF
}

confirm() {
  local prompt="$1" reply
  [[ "$ASSUME_YES" == true ]] && return 0
  read -r -p "$prompt [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

# --- version <-> branch ------------------------------------------------------

version_to_branch() { # 4.0.2 -> v4-0-2
  local v="${1#v}"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  echo "v${v//./-}"
}

branch_to_version() { # v4-0-2 -> 4.0.2
  local b="$1"
  [[ "$b" =~ ^v([0-9]+)-([0-9]+)-([0-9]+)$ ]] || return 1
  echo "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}"
}

version_is_patch() { # Z > 0
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.([0-9]+)$ ]] && ((BASH_REMATCH[1] > 0))
}

previous_patch_tag() { # 4.0.2 -> v4.0.1
  [[ "$1" =~ ^([0-9]+\.[0-9]+)\.([0-9]+)$ ]] || return 1
  echo "v${BASH_REMATCH[1]}.$((BASH_REMATCH[2] - 1))"
}

# --- upstream queries --------------------------------------------------------

ls_remote() { git ls-remote "$UPSTREAM_URL" "$@"; }

tag_exists() {
  local target
  target=$(resolve_tag_commit "$1") || return 2
  [[ -n "$target" ]]
}

branch_head() {
  local branch="$1" refs
  refs=$(ls_remote "refs/heads/$branch") || return 2
  awk -v ref="refs/heads/$branch" '$2 == ref { print $1 }' <<<"$refs"
}

resolve_tag_commit() {
  local tag="$1" refs peeled sha
  refs=$(ls_remote "refs/tags/$tag" "refs/tags/$tag^{}") || return $?
  peeled=$(awk -v ref="refs/tags/$tag^{}" '$2 == ref { print $1 }' <<<"$refs")
  sha=$(awk -v ref="refs/tags/$tag" '$2 == ref { print $1 }' <<<"$refs")
  echo "${peeled:-$sha}"
}

# Newest v*-*-* release branch, optionally only untagged ones. Shipping tags
# the version, so "tag exists" is what closes a train — but ship itself also
# needs to find a tagged train whose remaining steps (release, ISO, website)
# didn't finish, so it can resume.
newest_release_branch() { # newest_release_branch [--untagged]
  local untagged_only=false refs
  [[ "${1:-}" == "--untagged" ]] && untagged_only=true
  local branch best_ver="" best_branch="" ver
  refs=$(ls_remote 'refs/heads/v*' 'refs/tags/v*') || return 2
  while IFS= read -r branch; do
    ver=$(branch_to_version "$branch") || continue
    if [[ "$untagged_only" == true ]] &&
      awk -v ref="refs/tags/v$ver" '$2 == ref { found = 1 } END { exit !found }' <<<"$refs"; then
      continue
    fi
    if [[ -z "$best_ver" ]] || [[ $(vercmp "$ver" "$best_ver") -gt 0 ]]; then
      best_ver="$ver" best_branch="$branch"
    fi
  done < <(awk '$2 ~ /^refs\/heads\/v/ { sub("refs/heads/", "", $2); print $2 }' <<<"$refs")
  [[ -n "$best_branch" ]] && echo "$best_branch"
}

find_release_branch() { # find_release_branch [--untagged]; empty when none
  local branch lookup_status=0
  branch=$(newest_release_branch "$@") || lookup_status=$?
  case "$lookup_status" in
  0) echo "$branch" ;;
  1) return 0 ;;
  *)
    print_error "Could not query release branches and tags on $UPSTREAM_REPO" >&2
    return "$lookup_status"
    ;;
  esac
}

open_train_branch() { find_release_branch --untagged; }

# Reads go over anonymous HTTPS; pushes go over SSH like every checkout the
# operator owns. Pushing over HTTPS would drag in git's credential-helper
# config, which breaks the moment a stale absolute gh path is baked into it.
ssh_push_url() { # https://github.com/a/b.git -> git@github.com:a/b.git
  local url="$1"
  if [[ "$url" =~ ^https://github\.com/(.+)$ ]]; then
    echo "git@github.com:${BASH_REMATCH[1]}"
  else
    echo "$url"
  fi
}
UPSTREAM_PUSH_URL="${OMARCHY_UPSTREAM_PUSH_URL:-$(ssh_push_url "$UPSTREAM_URL")}"

ensure_mirror_clone() {
  if [[ -d "$MIRROR_CLONE" ]]; then
    git -C "$MIRROR_CLONE" fetch --quiet origin
  else
    mkdir -p "$SRCDEST_DIR"
    print_info "Cloning $UPSTREAM_URL (cached in $SRCDEST_DIR)..."
    git clone --mirror --quiet "$UPSTREAM_URL" "$MIRROR_CLONE"
  fi
  git -C "$MIRROR_CLONE" remote set-url --push origin "$UPSTREAM_PUSH_URL"
}

ensure_work_clone() {
  if [[ -d "$WORK_CLONE" ]]; then
    git -C "$WORK_CLONE" fetch --quiet origin
  else
    mkdir -p "$SRCDEST_DIR"
    print_info "Cloning $UPSTREAM_URL working copy..."
    git clone --quiet "$UPSTREAM_URL" "$WORK_CLONE"
  fi
  git -C "$WORK_CLONE" remote set-url --push origin "$UPSTREAM_PUSH_URL"
}

# --- published channel state -------------------------------------------------

# Prints the shared published version of the omarchy package pair. A missing or
# divergent pair is invalid release evidence, not an older/empty channel.
published_pair_from_descs() {
  awk '
    function emit() {
      if ((name == "omarchy" || name == "omarchy-settings") && version != "") {
        versions[name] = version
      }
      name = ""; version = ""
    }
    $0 == "%FILENAME%" { emit(); next }
    $0 == "%NAME%"     { getline; name = $0; next }
    $0 == "%VERSION%"  { getline; version = $0; next }
    END {
      emit()
      if (versions["omarchy"] != "" &&
          versions["omarchy"] == versions["omarchy-settings"]) {
        print versions["omarchy"]
      } else {
        exit 3
      }
    }
  '
}

# Returns 2 when the database cannot be read and 3 when the package pair is
# missing or divergent. Callers must not mistake either state for absence.
published_version() {
  local channel="$1" tmp descs
  tmp=$(mktemp) || return 2
  # A unique query string busts the CDN cache: right after a sync the plain
  # URL can keep serving the previous db for a while, which reads as "not
  # published yet" to status, the wait loop, and ship's pre-checks.
  if ! curl -sf "$PKGS_DB_BASE/$channel/x86_64/omarchy.db.tar.zst?$(date +%s%N)" -o "$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  if ! descs=$(tar -xO --zstd -f "$tmp" --wildcards '*/desc' 2>/dev/null); then
    rm -f "$tmp"
    return 2
  fi
  rm -f "$tmp"
  published_pair_from_descs <<<"$descs"
}

# The rc branch of THIS repo carries the current pins. Read them without
# touching the working tree.
release_pin_at_ref() { # release_pin_at_ref <git-ref> [repository]; prints "pkgver pkgrel commit"
  local ref="$1" repo="${2:-$BUILD_ROOT}" runtime settings runtime_meta settings_meta
  runtime=$(git -C "$repo" show "$ref:pkgbuilds/omarchy/PKGBUILD") || return $?
  settings=$(git -C "$repo" show "$ref:pkgbuilds/omarchy-settings/PKGBUILD") || return $?

  local field
  for field in _tag _commit pkgver pkgrel; do
    [[ $(grep -Ec "^${field}=" <<<"$runtime") -eq 1 ]] || return 1
    [[ $(grep -Ec "^${field}=" <<<"$settings") -eq 1 ]] || return 1
  done
  [[ $(grep -Ec '^[[:space:]]*sha256sums=' <<<"$runtime") -eq 2 ]] || return 1
  [[ $(grep -Ec '^[[:space:]]*sha256sums=' <<<"$settings") -eq 2 ]] || return 1
  [[ $(grep -Ec '^[[:space:]]*sha256sums=\(\)[[:space:]]*$' <<<"$runtime") -eq 1 ]] || return 1
  [[ $(grep -Ec '^[[:space:]]*sha256sums=\(\)[[:space:]]*$' <<<"$settings") -eq 1 ]] || return 1

  runtime_meta=$(grep -E '^[[:space:]]*(_tag|_commit|pkgver|pkgrel|sha256sums)=' <<<"$runtime") || return 1
  settings_meta=$(grep -E '^[[:space:]]*(_tag|_commit|pkgver|pkgrel|sha256sums)=' <<<"$settings") || return 1
  [[ "$runtime_meta" == "$settings_meta" ]] || return 1

  local runtime_ver runtime_commit runtime_tag runtime_rel runtime_sha
  runtime_ver=$(grep -E '^pkgver=' <<<"$runtime" | head -1 | cut -d= -f2 | tr -d "'\"")
  runtime_commit=$(grep -E '^_commit=' <<<"$runtime" | head -1 | cut -d= -f2 | tr -d "'\"")
  runtime_tag=$(grep -E '^_tag=' <<<"$runtime" | head -1 | cut -d= -f2 | tr -d "'\"")
  runtime_rel=$(grep -E '^pkgrel=' <<<"$runtime" | head -1 | cut -d= -f2 | tr -d "'\"")
  runtime_sha=$(grep -E "^[[:space:]]*sha256sums=\('[0-9a-f]{64}'\)[[:space:]]*$" <<<"$runtime" | tail -1 | grep -oE '[0-9a-f]{64}') || return 1

  [[ "$runtime_ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+(rc[0-9]+)?$ ]] || return 1
  [[ "$runtime_commit" =~ ^[0-9a-f]{40}$ ]] || return 1
  [[ -z "$runtime_tag" || "$runtime_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$runtime_rel" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$runtime_sha" =~ ^[0-9a-f]{64}$ ]] || return 1
  echo "$runtime_ver $runtime_rel $runtime_commit"
}

rc_branch_pin() { # prints "pkgver pkgrel commit", empty when no rc branch
  local pin
  git -C "$BUILD_ROOT" fetch --quiet --prune origin || return $?
  git -C "$BUILD_ROOT" show-ref --verify --quiet refs/remotes/origin/rc || return 0
  pin=$(release_pin_at_ref origin/rc) || return $?
  release_pin_commit_has_exact_scope origin/rc || {
    print_error "origin/rc tip changes files outside the release package pair" >&2
    return 1
  }
  release_pin_branch_matches_master origin/rc || {
    print_error "origin/rc is not master plus exactly one release pin commit" >&2
    return 1
  }
  echo "$pin"
}

pin_version() { printf '%s\n' "${1%% *}"; }
pin_pkgrel() {
  local rest="${1#* }"
  printf '%s\n' "${rest%% *}"
}
pin_source_commit() { printf '%s\n' "${1##* }"; }
pin_package_version() { printf '%s-%s\n' "$(pin_version "$1")" "$(pin_pkgrel "$1")"; }
published_version_matches_pin() { [[ "$1" == "$(pin_package_version "$2")" ]]; }

# --- build host --------------------------------------------------------------
#
# Every command runs from anywhere: when this machine IS the build host
# (on_repo_host — the published database lives here), host operations execute
# locally; otherwise they go over ssh to the configured destination. The
# destination is anything ssh accepts — root@<ip>, root@<hostname>, or an
# ~/.ssh/config Host alias — from --host, $OMARCHY_REPO_HOST, or .repo-host.

repo_host() { resolve_repo_host "$REPO_HOST_OVERRIDE"; }

print_no_host_help() { # print_no_host_help <what> <script>
  print_warning "Not on the build host, and none configured (--host, OMARCHY_REPO_HOST, or $BUILD_ROOT/.repo-host — any ssh destination, e.g. root@<host> or an ssh-config alias)"
  echo "Run this on the build host to $1:" >&2
  echo "$2" >&2
}

# Builds the pinned release pair for the rc channel from the rc branch's own
# worktree, creating it on first use. OMARCHY_RC_PINS marks this as the one
# build allowed to set those packages' rc versions; OMARCHY_REPO_ROOT points
# the worktree at the primary checkout's channel tree so all three channels
# stay in one place. Fast-ring packages are not built here — the scheduled rc
# release covers those from master.
RC_TRIGGER_SCRIPT='
set -e
git -C /root/omarchy-pkgs fetch origin rc
if [ ! -d /root/omarchy-pkgs-rc ]; then
  git -C /root/omarchy-pkgs worktree add /root/omarchy-pkgs-rc rc 2>/dev/null ||
    git -C /root/omarchy-pkgs worktree add --track -b rc /root/omarchy-pkgs-rc origin/rc
fi
git -C /root/omarchy-pkgs-rc fetch origin rc
git -C /root/omarchy-pkgs-rc reset --hard origin/rc
cd /root/omarchy-pkgs-rc
OMARCHY_RC_PINS=1 OMARCHY_REPO_ROOT=/root/omarchy-pkgs/pkgs.omarchy.org \
  bin/repo release --mirror rc --package omarchy omarchy-settings --skip-prod-check
'

trigger_rc_build() {
  local host
  if host=$(repo_host); then
    print_info "Building the RC on $host (this takes a while)..."
    ssh "$host" "set -e; source /root/.omarchy/build-credentials; $RC_TRIGGER_SCRIPT"
  elif on_repo_host; then
    print_info "Building the RC locally (this is the build host)..."
    bash -c "$RC_TRIGGER_SCRIPT"
  else
    print_no_host_help "build the release candidate" "$RC_TRIGGER_SCRIPT"
    return 1
  fi
}

require_release_step() { # require_release_step <description> <command...>
  local description="$1" status=0
  shift
  "$@" || status=$?
  if ((status != 0)); then
    print_error "$description failed (exit $status)"
    return "$status"
  fi
}

host_advance() { # host_advance <from> <to> [extra args...]
  local from="$1" to="$2"
  shift 2
  # bin/repo is the remote control: with a host configured it forwards this
  # over ssh itself; on the host it runs locally. Only the "neither" case —
  # a workstation with no host — must be refused here, because running it
  # against this machine's (likely stale) local tree would be wrong.
  if ! resolve_repo_host "$REPO_HOST_OVERRIDE" >/dev/null && ! on_repo_host; then
    print_no_host_help "advance $from -> $to" \
      "  cd /root/omarchy-pkgs && bin/repo advance --from $from --to $to --skip-prod-check $*"
    return 1
  fi
  "$BUILD_ROOT/bin/repo" advance --from "$from" --to "$to" --skip-prod-check "$@"
}

wait_for_published() { # wait_for_published <channel> <pkgver-pkgrel> [timeout-seconds]
  local channel="$1" want="$2" timeout="${3:-3600}" waited=0 got
  print_info "Waiting for $want to appear in the $channel channel (up to $((timeout / 60))m)..."
  while ((waited < timeout)); do
    got=$(published_version "$channel" 2>/dev/null) || got=""
    if [[ "$got" == "$want" ]]; then
      print_success "$channel now serves omarchy $got"
      return 0
    fi
    sleep 60
    waited=$((waited + 60))
    printf '.' >&2
  done
  echo "" >&2
  print_warning "Timed out waiting for $want in $channel (currently: ${got:-unknown})"
  print_info "The build may still be running — re-run this command to resume."
  return 1
}

# --- pkgs rc branch (pin commits) --------------------------------------------

# The rc branch is rebuilt as origin/master + pin commit(s) for each cut and
# force-pushed; the build host follows with reset --hard. History on it is
# disposable — the pins fully describe the release.
prepare_rc_worktree() {
  git -C "$BUILD_ROOT" fetch --quiet origin
  if [[ ! -d "$RC_WORKTREE" ]]; then
    mkdir -p "$(dirname "$RC_WORKTREE")"
    git -C "$BUILD_ROOT" worktree add --quiet -B rc "$RC_WORKTREE" origin/master
  else
    git -C "$RC_WORKTREE" checkout --quiet -B rc origin/master
    git -C "$RC_WORKTREE" reset --quiet --hard origin/master
  fi
}

cut_pins() { # cut_pins <omarchy-pkgs release args...>
  prepare_rc_worktree
  # The pin engine's "edge DB" is the ordering floor and rc auto-numbering
  # source; in the pipeline model that floor is the rc channel.
  (cd "$RC_WORKTREE" &&
    OMARCHY_EDGE_DB_URL="$RC_DB_URL" bin/omarchy-pkgs release "$@" --no-push --yes)
  git -C "$RC_WORKTREE" push --force-with-lease origin rc
}

# --- ISO ---------------------------------------------------------------------

canonical_github_repo() {
  local url="$1" repo
  case "$url" in
  https://github.com/*) repo=${url#https://github.com/} ;;
  git@github.com:*) repo=${url#git@github.com:} ;;
  *) return 1 ;;
  esac
  repo=${repo%.git}
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  printf '%s\n' "$repo"
}

validate_release_checkout() { # validate_release_checkout <directory> <repo> [read|write]
  local dir="$1" expected_repo="$2" access="${3:-read}" actual commit push_url worktree_status
  local push_urls=()
  [[ "$expected_repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
    print_error "Invalid configured GitHub repository: $expected_repo" >&2
    return 1
  }
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    print_error "Release checkout is not a git worktree: $dir" >&2
    return 1
  }
  actual=$(git -C "$dir" remote get-url origin 2>/dev/null) || {
    print_error "Release checkout has no readable origin: $dir" >&2
    return 1
  }
  [[ $(canonical_github_repo "$actual") == "$expected_repo" ]] || {
    print_error "Release checkout origin mismatch at $dir" >&2
    print_error "Expected github.com/$expected_repo, found $actual" >&2
    return 1
  }
  if [[ "$access" == write ]]; then
    while IFS= read -r push_url; do
      [[ -n "$push_url" ]] && push_urls+=("$push_url")
    done < <(git -C "$dir" remote get-url --push --all origin 2>/dev/null || true)
    if (( ${#push_urls[@]} != 1 )) ||
      [[ $(canonical_github_repo "${push_urls[0]:-}") != "$expected_repo" ]]; then
      print_error "Release checkout push origin mismatch at $dir" >&2
      print_error "Expected exactly github.com/$expected_repo, found: ${push_urls[*]:-<none>}" >&2
      return 1
    fi
  fi
  worktree_status=$(git -C "$dir" status --porcelain) || {
    print_error "Could not inspect release checkout state: $dir" >&2
    return 1
  }
  [[ -z "$worktree_status" ]] || {
    print_error "Release checkout is dirty: $dir" >&2
    print_error "Commit, stash, or remove local changes before releasing" >&2
    return 1
  }
  commit=$(git -C "$dir" rev-parse HEAD) || return 1
  print_info "Using $expected_repo at ${commit:0:12}" >&2
}

fetch_iso_release_ref() { # fetch_iso_release_ref <directory>
  local dir="$1"
  git -C "$dir" fetch --quiet --prune origin \
    "+refs/heads/$ISO_BRANCH:refs/remotes/origin/$ISO_BRANCH" || {
    print_error "Could not fetch origin/$ISO_BRANCH at $dir" >&2
    print_error "Refusing to release from stale ISO sources" >&2
    return 1
  }
  git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$ISO_BRANCH" || {
    print_error "ISO checkout has no origin/$ISO_BRANCH: $dir" >&2
    return 1
  }
}

require_iso_release_ref() { # require_iso_release_ref <directory>
  local dir="$1" head remote_head
  validate_release_checkout "$dir" "$ISO_REPO" || return 1
  fetch_iso_release_ref "$dir" || return 1
  head=$(git -C "$dir" rev-parse HEAD) || return 1
  remote_head=$(git -C "$dir" rev-parse "origin/$ISO_BRANCH") || return 1
  if [[ "$head" != "$remote_head" ]]; then
    print_error "ISO checkout is not at origin/$ISO_BRANCH: $dir" >&2
    print_error "Update it explicitly before releasing" >&2
    return 1
  fi
}

refresh_managed_iso_checkout() { # refresh_managed_iso_checkout <directory>
  local dir="$1" head remote_head
  validate_release_checkout "$dir" "$ISO_REPO" || return 1
  fetch_iso_release_ref "$dir" || return 1
  git -C "$dir" checkout --quiet --detach "origin/$ISO_BRANCH" || return $?
  head=$(git -C "$dir" rev-parse HEAD) || return 1
  remote_head=$(git -C "$dir" rev-parse "origin/$ISO_BRANCH") || return 1
  [[ "$head" == "$remote_head" ]] || {
    print_error "Managed ISO checkout did not reach origin/$ISO_BRANCH" >&2
    return 1
  }
}

iso_checkout() { # prints a usable omarchy-iso checkout, cloning to tmp if needed
  if [[ -n "${OMARCHY_ISO_DIR:-}" ]]; then
    [[ -d "$OMARCHY_ISO_DIR" ]] || {
      print_error "OMARCHY_ISO_DIR does not exist: $OMARCHY_ISO_DIR" >&2
      return 1
    }
    local explicit_dir
    explicit_dir=$(realpath "$OMARCHY_ISO_DIR")
    require_iso_release_ref "$explicit_dir" || return 1
    echo "$explicit_dir"
    return 0
  fi
  if git -C "$BUILD_ROOT/../omarchy-iso" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local sibling
    sibling=$(realpath "$BUILD_ROOT/../omarchy-iso")
    require_iso_release_ref "$sibling" || return 1
    echo "$sibling"
    return 0
  fi
  local tmp="$SRCDEST_DIR/omarchy-iso"
  if [[ ! -d "$tmp" ]]; then
    print_info "Cloning $ISO_REPO..." >&2
    git clone --quiet --branch "$ISO_BRANCH" "https://github.com/$ISO_REPO.git" "$tmp" || return $?
  fi
  refresh_managed_iso_checkout "$tmp" || return $?
  echo "$tmp"
}

doctor_iso_release_source() {
  local dir="" head remote_head refs
  [[ "$ISO_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  refs=$(git ls-remote "https://github.com/$ISO_REPO.git" "refs/heads/$ISO_BRANCH") || return 1
  remote_head=$(awk -v ref="refs/heads/$ISO_BRANCH" '$2 == ref { print $1 }' <<<"$refs")
  [[ "$remote_head" =~ ^[0-9a-f]{40}$ ]] || return 1

  if [[ -n ${OMARCHY_ISO_DIR:-} ]]; then
    [[ -d "$OMARCHY_ISO_DIR" ]] || return 1
    dir=$(realpath "$OMARCHY_ISO_DIR")
  elif git -C "$BUILD_ROOT/../omarchy-iso" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    dir=$(realpath "$BUILD_ROOT/../omarchy-iso")
  elif [[ -d "$SRCDEST_DIR/omarchy-iso" ]]; then
    dir="$SRCDEST_DIR/omarchy-iso"
  else
    # A managed checkout will be cloned by the release. Proving the configured
    # repository and branch exist is the complete read-only preflight here.
    return 0
  fi

  validate_release_checkout "$dir" "$ISO_REPO" || return 1
  head=$(git -C "$dir" rev-parse HEAD) || return 1
  [[ "$head" == "$remote_head" ]]
}

doctor_package_destination() {
  local host destination
  destination=$(package_publish_destination "$PKGS_RCLONE_DEST") || return 1
  if host=$(repo_host); then
    ssh -o ConnectTimeout=10 "$host" "EXPECTED_DESTINATION='$destination'"'
      set -e
      unset OMARCHY_PKGS_RCLONE_DEST
      source /root/.omarchy/build-credentials
      env | grep -q "^OMARCHY_PKGS_RCLONE_DEST="
      case "${OMARCHY_PKGS_RCLONE_DEST:-}" in pkgs.omarchy.org:*) exit 1 ;; esac
      printf "%s\n" "${OMARCHY_PKGS_RCLONE_DEST:-}" |
        grep -Eq "^[A-Za-z0-9._-]+:[A-Za-z0-9._~/-]+$"
      test "$OMARCHY_PKGS_RCLONE_DEST" = "$EXPECTED_DESTINATION"
      command -v rclone >/dev/null
      rclone lsf "$OMARCHY_PKGS_RCLONE_DEST" --files-only --max-depth 1 >/dev/null
    '
  elif on_repo_host; then
    command -v rclone >/dev/null 2>&1 || return 1
    rclone lsf "$destination" --files-only --max-depth 1 >/dev/null
  else
    return 1
  fi
}

doctor_iso_signing_credentials() {
  local dir
  dir=$(iso_checkout) || return 1
  (cd "$dir" && bin/omarchy-iso-sign --preflight)
}

doctor_iso_publication_credentials() {
  local dir
  dir=$(iso_checkout) || return 1
  (cd "$dir" && OMARCHY_ISO_RCLONE_DEST="$ISO_RCLONE_DEST" \
    bin/omarchy-iso-upload --preflight)
}

build_iso() { # build_iso <version> [--rc]
  local version="$1" rc_flag="${2:-}" dir
  dir=$(iso_checkout) || return 1
  if ! command -v docker >/dev/null || ! docker info >/dev/null 2>&1; then
    print_warning "Docker unavailable — cannot build the ISO here. Run on a Docker machine:"
    echo "  cd $dir && bin/omarchy-iso-release ${rc_flag:+$rc_flag }$version"
    return 1
  fi
  print_info "Building ${rc_flag:+RC }ISO $version (this takes a while)..."
  (cd "$dir" && PATH="$dir/bin:$PATH" OMARCHY_ISO_RCLONE_DEST="$ISO_RCLONE_DEST" \
    bin/omarchy-iso-release ${rc_flag:+"$rc_flag"} "$version")
}

verify_published_iso() { # verify_published_iso <version>
  local version="$1" dir
  dir=$(iso_checkout) || return 1
  (cd "$dir" && OMARCHY_ISO_RCLONE_DEST="$ISO_RCLONE_DEST" \
    bin/omarchy-iso-upload --verify-published "omarchy-$version.iso")
}

ISO_RELEASED=false
maybe_iso() { # maybe_iso <version> <rc|final> <iso_mode: ask|yes|no>
  local version="$1" kind="$2" mode="$3" rc_flag="" status=0
  ISO_RELEASED=false
  [[ "$kind" == "rc" ]] && rc_flag="--rc"
  case "$mode" in
  no) return 0 ;;
  yes)
    build_iso "$version" "$rc_flag" || status=$?
    ;;
  ask)
    if confirm "Build and upload the ${kind} ISO for $version?"; then
      build_iso "$version" "$rc_flag" || status=$?
    else
      print_info "ISO not released; leaving the website unchanged"
      print_info "Re-run with --iso to finish or --no-iso to explicitly waive it"
      return 3
    fi
    ;;
  *)
    print_error "Invalid ISO release mode: $mode"
    return 2
    ;;
  esac
  ((status == 0)) || return "$status"
  ISO_RELEASED=true
}

maybe_rc_iso() { # maybe_rc_iso <version> <iso_mode> <publication-confirmed>
  local version="$1" mode="$2" published="$3"
  if [[ "$published" != true ]]; then
    ISO_RELEASED=false
    if [[ "$mode" == yes ]]; then
      print_error "--no-wait cannot be combined with --iso for an unpublished RC"
      print_error "Wait for the RC to publish, then re-run: omarchy-release rc --iso"
      return 1
    fi
    if [[ "$mode" == ask ]]; then
      print_info "Not offering an ISO yet: --no-wait left RC publication unverified"
      print_info "After it publishes, re-run: omarchy-release rc --iso"
    fi
    return 0
  fi
  maybe_iso "$version" rc "$mode"
}

publish_ship_extras() { # publish_ship_extras <version> <iso_mode>
  local version="$1" mode="$2"
  if [[ "$mode" == resume ]]; then
    require_release_step "Published ISO verification" verify_published_iso "$version" || return $?
    ISO_RELEASED=true
  else
    require_release_step "Final ISO release" maybe_iso "$version" final "$mode" || return $?
  fi
  if [[ "$ISO_RELEASED" == true ]]; then
    local site_status=0
    require_release_step "Website ISO update" update_website "$version" || site_status=$?
    if ((site_status != 0)); then
      print_info "The ISO is published; retry the site without rebuilding it:"
      print_info "  omarchy-release ship --resume-site"
      return "$site_status"
    fi
  else
    print_info "7/7 ISO not published; leaving the website untouched"
  fi
}

website_remote_references_version() { # website_remote_references_version <version>
  local version="$1" checkout refs ref result=1
  [[ "$SITE_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  checkout=$(mktemp -d) || return 1
  if git clone --quiet --depth 1 "https://github.com/$SITE_REPO.git" "$checkout/site"; then
    refs=$(git -C "$checkout/site" grep -IohE \
      'omarchy-[0-9]+\.[0-9]+\.[0-9]+(-rc)?\.iso' -- . 2>/dev/null) || refs=""
    if [[ -n "$refs" ]]; then
      result=0
      while IFS= read -r ref; do
        if [[ "$ref" != "omarchy-$version.iso" ]]; then
          result=1
          break
        fi
      done <<<"$refs"
    fi
  fi
  rm -rf -- "$checkout"
  return "$result"
}

# --- website -----------------------------------------------------------------

update_website() { # update_website <version>
  local version="$1" tmp="$SRCDEST_DIR/omarchy-site" default_ref target_branch
  local matches search_status=0 relative f edit_tmp
  print_info "Updating $SITE_REPO ISO references to $version..."
  if [[ -d "$tmp" ]]; then
    validate_release_checkout "$tmp" "$SITE_REPO" write || return 1
    if ! git -C "$tmp" fetch --quiet --prune origin; then
      print_error "Could not refresh the cached website checkout at $tmp"
      return 1
    fi
  else
    git clone --quiet "git@github.com:$SITE_REPO.git" "$tmp" || {
      print_warning "Could not clone $SITE_REPO — update the ISO URL there manually"
      return 1
    }
  fi
  validate_release_checkout "$tmp" "$SITE_REPO" write || return 1
  git -C "$tmp" remote set-head origin --auto >/dev/null 2>&1 || {
    print_error "Could not resolve the default branch for $SITE_REPO"
    return 1
  }
  default_ref=$(git -C "$tmp" symbolic-ref --quiet refs/remotes/origin/HEAD) || {
    print_error "The website checkout has no origin/HEAD"
    return 1
  }
  target_branch=${default_ref#refs/remotes/origin/}
  git -C "$tmp" checkout --quiet -B release-site-update "$default_ref" || return $?
  matches=$(git -C "$tmp" grep -IlE 'omarchy-[0-9]+\.[0-9]+\.[0-9]+(-rc)?\.iso' -- .) || search_status=$?
  if ((search_status > 1)); then
    print_error "Could not search tracked website files for ISO references"
    return "$search_status"
  fi
  if [[ -z "$matches" ]]; then
    print_warning "No omarchy-<version>.iso references found in $SITE_REPO — update it manually"
    return 1
  fi
  while IFS= read -r relative; do
    [[ -n "$relative" ]] || continue
    f="$tmp/$relative"
    if [[ ! -f "$f" || -L "$f" ]]; then
      print_error "Refusing unsafe tracked website file: $relative"
      return 1
    fi
    edit_tmp=$(mktemp "$SRCDEST_DIR/.omarchy-site-edit.XXXXXX") || return 1
    if ! sed -E "s/omarchy-[0-9]+\.[0-9]+\.[0-9]+(-rc)?\.iso/omarchy-$version.iso/g" "$f" >"$edit_tmp" ||
       ! cat "$edit_tmp" >"$f"; then
      rm -f -- "$edit_tmp"
      print_error "Could not update tracked website file: $relative"
      return 1
    fi
    rm -f -- "$edit_tmp" || return 1
    echo "  updated: $relative"
  done <<<"$matches"
  if git -C "$tmp" diff --quiet; then
    print_info "Website already references $version"
    return 0
  fi
  git -C "$tmp" --no-pager diff --stat
  confirm "Push this ISO URL bump to $SITE_REPO?" || {
    print_info "Left uncommitted in $tmp"
    return 1
  }
  if ! git -C "$tmp" commit --quiet -am "Point ISO download at omarchy-$version.iso" ||
     ! git -C "$tmp" push --quiet origin "HEAD:$target_branch"; then
    print_error "Could not publish the website ISO update"
    return 1
  fi
  print_success "Website updated to omarchy-$version.iso"
}

sync_final_pins_to_master() { # sync_final_pins_to_master <pin-sha>
  local pin_sha="$1" sync_wt="$BUILD_ROOT/.worktrees/master-sync" status=0
  git -C "$BUILD_ROOT" fetch --quiet origin || return $?
  if [[ ! -d "$sync_wt" ]]; then
    git -C "$BUILD_ROOT" worktree add --quiet -B release-master-sync "$sync_wt" origin/master || return $?
  else
    git -C "$sync_wt" checkout --quiet -B release-master-sync origin/master || return $?
  fi

  (cd "$sync_wt" && git cherry-pick "$pin_sha" && git push --quiet origin HEAD:master) || status=$?
  if ((status != 0)); then
    (cd "$sync_wt" && git cherry-pick --abort 2>/dev/null || true)
    return "$status"
  fi
}

release_pin_files_match() { # release_pin_files_match <left-ref> <right-ref> [repository]
  local repo="${3:-$BUILD_ROOT}"
  git -C "$repo" diff --quiet "$1" "$2" -- \
    pkgbuilds/omarchy/PKGBUILD \
    pkgbuilds/omarchy-settings/PKGBUILD
}

normalize_pkgbuild_release_fields() {
  sed -E \
    -e "s/^_tag=.*/_tag='<release>'/" \
    -e "s/^_commit=.*/_commit='<release>'/" \
    -e 's/^pkgver=.*/pkgver=<release>/' \
    -e 's/^pkgrel=.*/pkgrel=<release>/' \
    -e "s/^([[:space:]]*)sha256sums=\('[0-9a-f]{64}'\)[[:space:]]*$/\1sha256sums=('<release>')/"
}

release_pin_commit_has_exact_scope() { # release_pin_commit_has_exact_scope <ref> [repository]
  local ref="$1" repo="${2:-$BUILD_ROOT}" changed expected parent pkg before after
  changed=$(git -C "$repo" diff-tree --no-commit-id --name-only -r "$ref" | LC_ALL=C sort) || return $?
  expected=$'pkgbuilds/omarchy-settings/PKGBUILD\npkgbuilds/omarchy/PKGBUILD'
  [[ "$changed" == "$expected" ]] || return 1
  parent=$(git -C "$repo" rev-parse "$ref^") || return 1
  for pkg in omarchy omarchy-settings; do
    before=$(git -C "$repo" show "$parent:pkgbuilds/$pkg/PKGBUILD") || return 1
    after=$(git -C "$repo" show "$ref:pkgbuilds/$pkg/PKGBUILD") || return 1
    before=$(normalize_pkgbuild_release_fields <<<"$before") || return 1
    after=$(normalize_pkgbuild_release_fields <<<"$after") || return 1
    [[ "$before" == "$after" ]] || return 1
  done
}

release_pin_branch_matches_master() { # release_pin_branch_matches_master <pin-ref> [repository] [master-ref]
  local ref="$1" repo="${2:-$BUILD_ROOT}" master_ref="${3:-origin/master}" parent status=0
  parent=$(git -C "$repo" rev-parse "$ref^") || return 1
  git -C "$repo" diff --quiet "$parent" "$master_ref" -- || status=$?
  case "$status" in
  0) return 0 ;;
  1) ;;
  *) return "$status" ;;
  esac
  git -C "$repo" merge-base --is-ancestor "$parent" "$master_ref" || return $?
  release_pin_files_match "$ref" "$master_ref" "$repo"
}

validate_release_modes() { # validate_release_modes <command> <iso-mode> <wait>
  local command="$1" iso_mode="$2" wait="$3"
  if [[ "$iso_mode" == resume ]]; then
    if [[ "$command" != ship || "$wait" != true ]]; then
      print_error "--resume-site is only valid with ship and cannot use --no-wait"
      return 2
    fi
    return 0
  fi
  case "$command" in
  "" | rc | ship)
    if [[ "$wait" != true && "$iso_mode" == yes ]]; then
      print_error "--no-wait cannot be combined with --iso"
      print_error "Wait for the exact package build before releasing an ISO"
      return 2
    fi
    ;;
  *)
    if [[ "$iso_mode" != ask || "$wait" != true ]]; then
      print_error "ISO and wait options are only valid with rc, ship, or guided mode"
      return 2
    fi
    ;;
  esac
}

validate_command_args() { # validate_command_args <command> <arg-count>
  local command="$1" arg_count="$2"
  case "$command" in
  start)
    ((arg_count <= 1)) || {
      print_error "start accepts at most one version"
      return 2
    }
    ;;
  pick) ;;
  "" | rc | ship | status | doctor | self-test)
    ((arg_count == 0)) || {
      print_error "${command:-guided mode} does not accept positional arguments"
      return 2
    }
    ;;
  esac
}

require_tag_target() { # require_tag_target <tag> <expected-commit>
  local tag="$1" expected="$2" actual
  actual=$(resolve_tag_commit "$tag") || return $?
  if [[ -z "$actual" || "$actual" != "$expected" ]]; then
    print_error "Tag $tag resolves to '${actual:-nothing}', expected $expected"
    return 1
  fi
}

github_release_is_final() { # github_release_is_final <version>
  local state
  state=$(gh release view "v$1" --repo "$UPSTREAM_REPO" \
    --json isDraft,isPrerelease --jq '.isDraft == false and .isPrerelease == false') || return $?
  [[ "$state" == true ]]
}

cmd_resume_site() { # cmd_resume_site <version> <pin-version> <pkgrel> <pin-commit> <tag-commit>
  local version="$1" pin_ver="$2" pin_rel="$3" pin_commit="$4" tag_commit="$5"
  local expected_pin="$version $pin_rel $pin_commit" expected_package="$version-$pin_rel"
  local rc_pub stable_pub pin_sha rc_pin master_pin
  print_header "Resume website publication for $version"

  [[ "$pin_ver" == "$version" ]] || {
    print_error "Final $version pins are not present in rc"
    return 1
  }
  if ! rc_pub=$(published_version rc 2>/dev/null) || [[ "$rc_pub" != "$expected_package" ]]; then
    print_error "The exact $version package pair is not verifiably published in rc"
    return 1
  fi
  if ! stable_pub=$(published_version stable 2>/dev/null) || [[ "$stable_pub" != "$expected_package" ]]; then
    print_error "The exact $version package pair is not verifiably published in stable"
    return 1
  fi
  [[ -n "$tag_commit" && "$tag_commit" == "$pin_commit" ]] || {
    print_error "Tag v$version is absent or does not target $pin_commit"
    return 1
  }

  git -C "$BUILD_ROOT" fetch --quiet origin master rc || return $?
  pin_sha=$(git -C "$BUILD_ROOT" rev-parse origin/rc) || return 1
  release_pin_commit_has_exact_scope "$pin_sha" || {
    print_error "origin/rc pin commit has an unsafe scope"
    return 1
  }
  release_pin_branch_matches_master "$pin_sha" || {
    print_error "origin/rc is not based on the verified master release tree"
    return 1
  }
  rc_pin=$(release_pin_at_ref "$pin_sha") || rc_pin=""
  master_pin=$(release_pin_at_ref origin/master) || master_pin=""
  if [[ "$rc_pin" != "$expected_pin" || "$master_pin" != "$expected_pin" ]] ||
    ! release_pin_files_match origin/master "$pin_sha"; then
    print_error "rc/master do not carry the exact final $version pin files"
    return 1
  fi
  github_release_is_final "$version" || {
    print_error "GitHub release v$version is absent, draft, or prerelease"
    return 1
  }

  print_success "Package, tag, master, and GitHub release state verified"
  publish_ship_extras "$version" resume || return $?
  print_success "Website publication completed for $version without rebuilding the ISO"
}

# --- commands ----------------------------------------------------------------

cmd_start() {
  require_release_config
  local version="${1:-}"
  if [[ -z "$version" ]]; then
    read -r -p "Version to release (X.Y.Z): " version
  fi
  version="${version#v}"
  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    print_error "Invalid version '$version' (expected X.Y.Z)"
    exit 1
  fi
  local branch tag_status=0 existing_head
  branch=$(version_to_branch "$version")

  print_header "Open release train $version"

  tag_exists "v$version" || tag_status=$?
  if ((tag_status == 0)); then
    print_error "v$version is already tagged on $UPSTREAM_REPO — this train has shipped"
    exit 1
  elif ((tag_status > 1)); then
    print_error "Could not verify whether v$version already exists"
    exit 1
  fi

  # Base: previous tag for a patch, dev branch head for a minor/major.
  local base_ref base_sha kind
  if version_is_patch "$version"; then
    kind="patch"
    base_ref=$(previous_patch_tag "$version")
    tag_status=0
    tag_exists "$base_ref" || tag_status=$?
    if ((tag_status == 1)); then
      print_error "Base tag $base_ref not found on $UPSTREAM_REPO"
      exit 1
    elif ((tag_status > 1)); then
      print_error "Could not verify base tag $base_ref"
      exit 1
    fi
    base_sha=$(resolve_tag_commit "$base_ref") || {
      print_error "Could not resolve base tag $base_ref"
      exit 1
    }
  else
    kind="minor/major"
    base_ref="$DEV_BRANCH"
    base_sha=$(branch_head "$DEV_BRANCH") || {
      print_error "Could not query $DEV_BRANCH on $UPSTREAM_REPO"
      exit 1
    }
    [[ -n "$base_sha" ]] || {
      print_error "Development branch $DEV_BRANCH does not exist on $UPSTREAM_REPO"
      exit 1
    }
  fi

  existing_head=$(branch_head "$branch") || {
    print_error "Could not query release branch $branch"
    exit 1
  }
  if [[ -n "$existing_head" ]]; then
    print_success "Release branch $branch already exists — adopting it"
  else
    print_info "Release type: $kind — branching $branch from $base_ref (${base_sha:0:12})"
    confirm "Create branch $branch on $UPSTREAM_REPO?" || exit 1
    ensure_mirror_clone
    git -C "$MIRROR_CLONE" push --quiet origin "$base_sha:refs/heads/$branch"
    print_success "Created $branch"
  fi

  # Staging PR: the body is the release-notes staging ground. A branch with no
  # commits beyond its base cannot carry a PR yet; created lazily by pick.
  if command -v gh >/dev/null; then
    if gh pr view "$branch" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
      print_success "Staging PR for $branch already open"
    elif ! gh pr create --repo "$UPSTREAM_REPO" --draft --base "$DEV_BRANCH" --head "$branch" \
      --title "Release v$version" \
      --body "Staging ground for the v$version release notes. Edit this body — it becomes the GitHub release text." 2>/dev/null; then
      print_info "Staging PR not created yet (no commits on $branch) — it opens after the first pick"
    fi
  fi

  # Minor/major trains ship new edge packages: carry edge forward into rc so
  # RC testing runs against the set stable users will get. A failed advance
  # must not pass silently — RCs would test against the previous rc set.
  if [[ "$kind" != "patch" ]]; then
    if ! host_advance edge rc; then
      print_error "edge → rc advance did not complete — the train is NOT fully open"
      echo "Fix the advance (it is idempotent), then re-run: omarchy-release start $version"
      echo "start is idempotent too — the branch and PR above are kept."
      exit 1
    fi
  else
    print_info "Patch train: rc already mirrors stable — nothing to advance"
  fi

  echo ""
  print_success "Train $version is open"
  print_info "Next: omarchy-release pick   (cherry-pick fixes), then omarchy-release rc"
}

cmd_pick() {
  require_release_config
  local branch version
  branch=$(open_train_branch) || exit $?
  if [[ -z "$branch" ]]; then
    print_error "No open release train — run: omarchy-release start"
    exit 1
  fi
  version=$(branch_to_version "$branch")
  print_header "Pick changes onto $branch ($version)"

  ensure_work_clone
  git -C "$WORK_CLONE" checkout --quiet -B "$branch" "origin/$branch"

  # Changes usually reach a release branch as BACKPORTS — cherry-picks with
  # new SHAs — so ancestry of the original development merge proves nothing
  # on a patch branch. Detect equivalence the way it is actually recorded:
  # the branch's own commit messages since it left the development branch name the PR
  # ("backport of #N", squash titles "(#N)") or the source commit
  # ("cherry picked from commit <sha>", which pick -x writes) — or, failing
  # both, repeat its title verbatim.
  local base_commit base_date branch_log
  base_commit=$(git -C "$WORK_CLONE" merge-base "origin/$branch" "origin/$DEV_BRANCH" 2>/dev/null) || base_commit=""
  base_date=""
  if [[ -n "$base_commit" ]]; then
    base_date=$(TZ=UTC git -C "$WORK_CLONE" log -1 --format=%cd \
      --date=format-local:'%Y-%m-%dT%H:%M:%SZ' "$base_commit" 2>/dev/null) || base_date=""
  fi
  branch_log=$(git -C "$WORK_CLONE" log --format='%s %b' "origin/$branch" ${base_commit:+--not "$base_commit"} 2>/dev/null)
  # Subjects alone, with any trailing "(#N)" stripped, so a change re-applied by
  # hand — no PR number, no cherry-pick trailer — is still recognised by title.
  local branch_subjects
  branch_subjects=$(git -C "$WORK_CLONE" log --format='%s' "origin/$branch" ${base_commit:+--not "$base_commit"} 2>/dev/null |
    sed -E 's/ \(#[0-9]+\)$//')

  already_on_branch() { # already_on_branch <merge-sha> <pr-number-or-empty> <title-or-empty>
    local sha="$1" number="$2" title="$3"
    if [[ -n "$sha" ]]; then
      git -C "$WORK_CLONE" merge-base --is-ancestor "$sha" "origin/$branch" 2>/dev/null && return 0
      grep -q "cherry picked from commit $sha" <<<"$branch_log" && return 0
    fi
    if [[ -n "$number" ]]; then
      grep -qE "#$number([^0-9]|$)" <<<"$branch_log" && return 0
    fi
    if [[ -n "$title" ]]; then
      grep -Fxq "$title" <<<"$branch_subjects" && return 0
    fi
    return 1
  }

  local -a shas=() labels=()
  if [[ $# -gt 0 ]]; then
    local arg sha title
    for arg in "$@"; do
      if [[ "$arg" =~ ^[0-9]+$ ]]; then
        sha=$(gh pr view "$arg" --repo "$UPSTREAM_REPO" --json mergeCommit --jq '.mergeCommit.oid' 2>/dev/null)
        title=$(gh pr view "$arg" --repo "$UPSTREAM_REPO" --json title --jq '.title' 2>/dev/null)
        if [[ -z "$sha" || "$sha" == "null" ]]; then
          print_error "PR #$arg has no merge commit (not merged?)"
          exit 1
        fi
        if already_on_branch "$sha" "$arg" "$title"; then
          print_info "PR #$arg is already on $branch — skipping"
          continue
        fi
        shas+=("$sha") labels+=("PR #$arg: $title")
      else
        if already_on_branch "$arg" "" ""; then
          print_info "commit $arg is already on $branch — skipping"
          continue
        fi
        shas+=("$arg") labels+=("commit $arg")
      fi
    done
  else
    # Interactive: merged dev-branch PRs not already on the release branch
    # (by ancestry, backport reference, cherry-pick trailer, or title), oldest
    # first so picks apply in merge order.
    print_info "Loading merged $DEV_BRANCH PRs not yet on $branch..."
    # gh pr list orders by CREATION date, so a plain --limit window silently
    # drops long-lived PRs — opened early, merged recently — which are exactly
    # the ones a release branch still needs. Pull a wide window and bound it by
    # the branch point instead: anything merged into $DEV_BRANCH before $branch
    # left it is already here by ancestry.
    local list jq_pick
    jq_pick='sort_by(.mergedAt) | .[] | "\(.mergeCommit.oid)\t\(.number)\t\(.title)"'
    [[ -n "$base_date" ]] && jq_pick="[.[] | select(.mergedAt >= \"$base_date\")] | $jq_pick"
    list=$(gh pr list --repo "$UPSTREAM_REPO" --state merged --base "$DEV_BRANCH" \
      --limit 300 --json number,title,mergeCommit,mergedAt --jq "$jq_pick")
    local -a cand_shas=() cand_labels=()
    local sha number title
    while IFS=$'\t' read -r sha number title; do
      [[ -z "$sha" || "$sha" == "null" ]] && continue
      already_on_branch "$sha" "$number" "$title" && continue
      cand_shas+=("$sha") cand_labels+=("#$number $title")
    done <<<"$list"
    if [[ ${#cand_shas[@]} -eq 0 ]]; then
      print_success "Nothing to pick — every $DEV_BRANCH PR merged since $branch opened is already on it"
      exit 0
    fi
    echo ""
    local i
    for i in "${!cand_labels[@]}"; do
      printf '  %2d) %s\n' "$((i + 1))" "${cand_labels[$i]}"
    done
    echo ""
    local selection
    read -r -p "Pick which? (e.g. 1,3-5 or 'all'): " selection
    if [[ "$selection" == "all" ]]; then
      shas=("${cand_shas[@]}") labels=("${cand_labels[@]}")
    else
      local part
      for part in ${selection//,/ }; do
        if [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
          for ((i = BASH_REMATCH[1]; i <= BASH_REMATCH[2]; i++)); do
            shas+=("${cand_shas[$((i - 1))]}") labels+=("${cand_labels[$((i - 1))]}")
          done
        elif [[ "$part" =~ ^[0-9]+$ ]]; then
          shas+=("${cand_shas[$((part - 1))]}") labels+=("${cand_labels[$((part - 1))]}")
        fi
      done
    fi
  fi

  [[ ${#shas[@]} -eq 0 ]] && { print_info "Nothing selected."; exit 0; }

  local i
  for i in "${!shas[@]}"; do
    print_info "Cherry-picking ${labels[$i]}..."
    if ! git -C "$WORK_CLONE" cherry-pick -x -m 1 "${shas[$i]}" 2>/dev/null &&
      ! { git -C "$WORK_CLONE" cherry-pick --abort 2>/dev/null; git -C "$WORK_CLONE" cherry-pick -x "${shas[$i]}"; }; then
      print_error "Cherry-pick conflict on ${labels[$i]}"
      echo "Resolve it in $WORK_CLONE (git cherry-pick --continue), push, and re-run."
      exit 1
    fi
  done

  git -C "$WORK_CLONE" push --quiet origin "$branch"
  print_success "Picked ${#shas[@]} change(s) onto $branch"

  # The staging PR can exist now that the branch has commits of its own.
  if command -v gh >/dev/null && ! gh pr view "$branch" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
    gh pr create --repo "$UPSTREAM_REPO" --draft --base "$DEV_BRANCH" --head "$branch" \
      --title "Release v$version" \
      --body "Staging ground for the v$version release notes. Edit this body — it becomes the GitHub release text." 2>/dev/null &&
      print_success "Opened the release-notes staging PR" || true
  fi
  print_info "Next: omarchy-release rc"
}

cmd_rc() {
  require_release_config
  local iso_mode="$1" wait="$2"
  local branch version
  branch=$(open_train_branch) || exit $?
  if [[ -z "$branch" ]]; then
    print_error "No open release train — run: omarchy-release start"
    exit 1
  fi
  version=$(branch_to_version "$branch")
  print_header "Cut RC for train $version"

  local head
  head=$(branch_head "$branch") || {
    print_error "Could not resolve $branch before cutting an RC"
    exit 1
  }
  [[ -n "$head" ]] || {
    print_error "Release branch $branch disappeared before the RC cut"
    exit 1
  }
  print_info "Branch $branch head: ${head:0:12}"

  # Idempotence: if the current rc pin already matches the branch head and is
  # published, there is nothing to cut.
  local pin
  pin=$(rc_branch_pin) || return $?
  if [[ -n "$pin" ]]; then
    local pin_ver pin_rel pin_commit
    pin_ver=$(pin_version "$pin")
    pin_rel=$(pin_pkgrel "$pin")
    pin_commit=$(pin_source_commit "$pin")
    if [[ "$pin_commit" == "$head" && "$pin_ver" =~ ^${version//./\\.}rc[0-9]+$ ]]; then
      local pub
      if ! pub=$(published_version rc 2>/dev/null); then
        print_error "Cannot verify the published omarchy package pair in rc"
        return 1
      fi
      if published_version_matches_pin "$pub" "$pin"; then
        print_success "$pin_ver is already cut from this head and published to rc"
        maybe_rc_iso "$version" "$iso_mode" true
        return 0
      fi
      print_info "$pin_ver is pinned from this head but not published yet — re-triggering the build"
      require_release_step "RC build trigger" trigger_rc_build || return $?
      local publication_confirmed=false
      if [[ "$wait" == true ]]; then
        wait_for_published rc "$pin_ver-$pin_rel" || return $?
        publication_confirmed=true
      fi
      maybe_rc_iso "$version" "$iso_mode" "$publication_confirmed" || return $?
      return 0
    fi
  fi

  confirm "Pin omarchy + omarchy-settings to $branch@${head:0:12} as the next ${version}rcN and publish to rc?" || exit 1

  cut_pins rc --base "$version" --ref "$branch"

  local new_pin new_ver new_rel new_commit
  new_pin=$(rc_branch_pin) || return $?
  new_ver=$(pin_version "$new_pin")
  new_rel=$(pin_pkgrel "$new_pin")
  new_commit=$(pin_source_commit "$new_pin")
  if [[ ! "$new_ver" =~ ^${version//./\\.}rc[0-9]+$ || "$new_commit" != "$head" ]]; then
    print_error "RC pin verification failed: found '${new_pin:-nothing}', expected ${version}rcN $head"
    return 1
  fi
  print_success "Pinned $new_ver (rc branch pushed)"

  require_release_step "RC build trigger" trigger_rc_build || return $?
  local publication_confirmed=false
  if [[ "$wait" == true ]]; then
    wait_for_published rc "$new_ver-$new_rel" || return 1
    publication_confirmed=true
  fi
  maybe_rc_iso "$version" "$iso_mode" "$publication_confirmed" || return $?
  echo ""
  print_info "Test the candidate, then: omarchy-release ship  (or pick + rc again)"
}

cmd_ship() {
  require_release_config
  local iso_mode="$1" wait="$2"
  local branch version
  branch=$(open_train_branch) || exit $?
  if [[ -z "$branch" ]]; then
    # A tagged train whose later steps (release, ISO, website) failed is
    # invisible to open_train_branch — find it so a re-run can resume.
    branch=$(find_release_branch) || exit $?
    if [[ -z "$branch" ]]; then
      print_error "No release train found — nothing to ship"
      exit 1
    fi
    version=$(branch_to_version "$branch")
    print_info "Resuming tagged-but-incomplete train $version"
  else
    version=$(branch_to_version "$branch")
  fi
  print_header "Ship $version"

  local head pin pin_ver pin_rel pin_commit tag_commit tag_preexists=false
  head=$(branch_head "$branch") || {
    print_error "Could not resolve release branch $branch"
    exit 1
  }
  pin=$(rc_branch_pin) || exit $?
  pin_ver=$(pin_version "$pin")
  pin_rel=$(pin_pkgrel "$pin")
  pin_commit=$(pin_source_commit "$pin")

  # The ship guard: only the exact commit an RC was cut from may ship. There
  # is no override — a moved branch means an untested tree; cut another rc.
  if [[ -z "$pin" ]]; then
    print_error "No RC has been cut for $version — run: omarchy-release rc"
    exit 1
  fi
  if [[ "$pin_ver" == "$version" ]]; then
    # Final already pinned (resume path). The artifacts come from pin_commit;
    # a branch that moved afterwards changes nothing already built or tagged.
    if [[ -n "$head" && "$head" != "$pin_commit" ]]; then
      print_warning "$branch moved after the final was pinned — shipping the pinned ${pin_commit:0:12}; newer commits need the next patch train"
    fi
  else
    if [[ ! "$pin_ver" =~ ^${version//./\\.}rc[0-9]+$ ]]; then
      print_error "No RC has been cut for $version (rc branch pins $pin_ver) — run: omarchy-release rc"
      exit 1
    fi
    if [[ "$pin_commit" != "$head" ]]; then
      local behind
      behind=$(git -C "$WORK_CLONE" rev-list --count "$pin_commit..origin/$branch" 2>/dev/null || echo "?")
      print_error "$branch has moved since $pin_ver was cut ($behind commit(s) untested)"
      echo "Only a commit an RC was cut from can ship. Cut another candidate:"
      echo "  omarchy-release rc"
      exit 1
    fi
    local pub
    if ! pub=$(published_version rc 2>/dev/null); then
      print_error "Cannot verify the published omarchy package pair in rc"
      exit 1
    fi
    if ! published_version_matches_pin "$pub" "$pin"; then
      print_error "$pin_ver is pinned but rc serves '${pub:-nothing}' — the candidate build hasn't published"
      echo "Wait for it (or re-run: omarchy-release rc), then ship."
      exit 1
    fi
  fi

  # A colliding tag is irreversible release state. Resolve and validate it
  # before pinning or promoting anything, not when the train reaches step 3.
  if ! tag_commit=$(resolve_tag_commit "v$version"); then
    print_error "Cannot query tag v$version before shipping"
    exit 1
  fi
  if [[ -n "$tag_commit" ]]; then
    require_release_step "Existing tag preflight" require_tag_target "v$version" "$pin_commit" || exit $?
    tag_preexists=true
  fi

  if [[ "$iso_mode" == resume ]]; then
    cmd_resume_site "$version" "$pin_ver" "$pin_rel" "$pin_commit" "$tag_commit" || exit $?
    return 0
  fi

  echo ""
  print_info "This will, in order (steps already done are skipped):"
  echo "  1. Pin the final $version from $branch@${pin_commit:0:12} and publish it to rc"
  echo "  2. Promote the rc channel to stable (packages + signatures + db)"
  echo "  3. Tag v$version on $UPSTREAM_REPO"
  echo "  4. Merge the final pins to master (edge overlap + record)"
  echo "  5. Create the GitHub release from the staging PR body"
  echo "  6. Build + upload the final ISO (${iso_mode})"
  echo "  7. Point the website at the new ISO"
  echo ""
  confirm "Ship $version?" || exit 1

  # 1. Final pins into rc
  local rc_pub stable_pub expected_package="$version-$pin_rel"
  if ! rc_pub=$(published_version rc 2>/dev/null); then
    print_error "1/7 Cannot verify the published omarchy package pair in rc"
    exit 1
  fi
  if [[ "$pin_ver" == "$version" && "$rc_pub" == "$expected_package" ]]; then
    print_success "1/7 Final $version already published to rc"
  else
    if [[ "$pin_ver" != "$version" ]]; then
      print_info "1/7 Pinning final $version..."
      cut_pins "v$version" --commit "$pin_commit"
      pin=$(rc_branch_pin) || exit 1
      pin_ver=$(pin_version "$pin")
      pin_rel=$(pin_pkgrel "$pin")
      local verified_pin_commit
      verified_pin_commit=$(pin_source_commit "$pin")
      if [[ "$pin_ver" != "$version" || "$verified_pin_commit" != "$pin_commit" ]]; then
        print_error "1/7 Final pin verification failed: found '${pin:-nothing}'"
        exit 1
      fi
      expected_package="$pin_ver-$pin_rel"
    else
      print_info "1/7 Final $version pinned — re-triggering build"
    fi
    require_release_step "Final package build trigger" trigger_rc_build || exit $?
    if [[ "$wait" != true ]]; then
      print_success "Final $version build queued"
      print_info "Publication is not verified; no promotion or release step was attempted"
      print_info "Re-run: omarchy-release ship"
      return 0
    fi
    wait_for_published rc "$expected_package" || exit 1
  fi

  # 2. Promote rc -> stable
  if ! stable_pub=$(published_version stable 2>/dev/null); then
    print_error "2/7 Cannot verify the published omarchy package pair in stable"
    exit 1
  fi
  if [[ "$stable_pub" == "$expected_package" ]]; then
    print_success "2/7 Stable already serves $version"
  else
    host_advance rc stable || exit 1
    if ! stable_pub=$(published_version stable 2>/dev/null); then
      print_error "2/7 Promotion completed, but the stable package pair cannot be verified"
      exit 1
    fi
    if [[ "$stable_pub" != "$expected_package" ]]; then
      print_error "Promotion ran but stable serves '${stable_pub:-nothing}' — investigate before continuing"
      exit 1
    fi
    print_success "2/7 Promoted to stable: omarchy $stable_pub"
  fi

  # 3. Tag — at the pinned commit the artifacts were built from, never the
  # branch head (they can differ on a resumed ship).
  if [[ "$tag_preexists" == true ]]; then
    print_success "3/7 Tag v$version already exists"
  else
    ensure_mirror_clone
    git -C "$MIRROR_CLONE" push --quiet origin "$pin_commit:refs/tags/v$version"
    print_success "3/7 Tagged v$version at ${pin_commit:0:12}"
  fi

  # 4. Final pins onto master (keeps edge overlap publishing and the repo record)
  git -C "$BUILD_ROOT" fetch --quiet origin master rc || {
    print_error "4/7 Could not refresh origin/master and origin/rc"
    exit 1
  }
  local expected_pin="$version $pin_rel $pin_commit" master_pin pin_sha rc_pin
  pin_sha=$(git -C "$BUILD_ROOT" rev-parse origin/rc) || exit 1
  release_pin_commit_has_exact_scope "$pin_sha" || {
    print_error "4/7 origin/rc pin commit changes files outside the release pair"
    exit 1
  }
  release_pin_branch_matches_master "$pin_sha" || {
    print_error "4/7 origin/rc is not master plus the release pin"
    exit 1
  }
  rc_pin=$(release_pin_at_ref "$pin_sha") || {
    print_error "4/7 The final origin/rc pin commit is malformed"
    exit 1
  }
  [[ "$rc_pin" == "$expected_pin" ]] || {
    print_error "4/7 origin/rc carries '$rc_pin', expected '$expected_pin'"
    exit 1
  }
  master_pin=$(release_pin_at_ref origin/master 2>/dev/null) || master_pin=""
  if [[ "$master_pin" == "$expected_pin" ]] && release_pin_files_match origin/master "$pin_sha"; then
    print_success "4/7 master already carries the exact $version pins"
  else
    print_info "4/7 Bringing the final pin commit to master..."
    require_release_step "Final pin synchronization to master" sync_final_pins_to_master "$pin_sha" || exit $?
    git -C "$BUILD_ROOT" fetch --quiet origin master || exit 1
    master_pin=$(release_pin_at_ref origin/master) || master_pin=""
    if [[ "$master_pin" != "$expected_pin" ]] || ! release_pin_files_match origin/master "$pin_sha"; then
      print_error "4/7 master verification failed: found '${master_pin:-invalid}', expected '$expected_pin'"
      exit 1
    fi
    print_success "4/7 Final pins merged to master"
  fi

  # 5. GitHub release from the staging PR body
  if gh release view "v$version" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
    github_release_is_final "$version" || {
      print_error "5/7 GitHub release v$version exists but is draft or prerelease"
      print_error "Publish it as a final release, then re-run ship"
      exit 1
    }
    print_success "5/7 GitHub release v$version already exists"
  else
    local notes
    notes=$(gh pr view "$branch" --repo "$UPSTREAM_REPO" --json body --jq '.body' 2>/dev/null) || notes=""
    if [[ -z "$notes" || "$notes" == "null" ]]; then
      notes="Omarchy $version"
      print_warning "No staging PR body found — using a bare title; edit the release afterwards"
    fi
    gh release create "v$version" --repo "$UPSTREAM_REPO" --verify-tag \
      --title "v$version" --notes "$notes"
    print_success "5/7 GitHub release v$version created"
  fi

  # 6–7. The website is a consumer of a successfully published ISO.
  publish_ship_extras "$version" "$iso_mode" || exit $?

  echo ""
  print_success "Shipped $version — rc and stable are in parity for the next patch train"
  print_info "Close the loop: merge or close the staging PR for $branch on $UPSTREAM_REPO"
}

# --- status / shepherd -------------------------------------------------------

gather_status() {
  EDGE_VER=$(published_version edge 2>/dev/null) || EDGE_VER="<unreachable>"
  RC_VER=$(published_version rc 2>/dev/null) || RC_VER="<unreachable>"
  STABLE_VER=$(published_version stable 2>/dev/null) || STABLE_VER="<unreachable>"
  TRAIN=$(open_train_branch) || return $?
  TRAIN_VER=""
  TRAIN_HEAD=""
  PIN=""
  if [[ -n "$TRAIN" ]]; then
    TRAIN_VER=$(branch_to_version "$TRAIN")
    TRAIN_HEAD=$(branch_head "$TRAIN") || return $?
    [[ -n "$TRAIN_HEAD" ]] || {
      print_error "Open release branch $TRAIN disappeared while gathering status"
      return 1
    }
    PIN=$(rc_branch_pin) || return $?
  fi
}

next_step() { # prints "<command>|<description>"
  if [[ -z "$TRAIN" ]]; then
    # A tagged train may still have unfinished ship steps (release/ISO/site).
    local last last_ver
    last=$(find_release_branch) || return $?
    if [[ -n "$last" && "$STABLE_VER" != "<unreachable>" ]]; then
      last_ver=$(branch_to_version "$last")
      if [[ "${STABLE_VER%-*}" != "$last_ver" ]] ||
        { command -v gh >/dev/null && ! github_release_is_final "$last_ver" >/dev/null 2>&1; }; then
        echo "ship|$last_ver is tagged but not fully shipped — resume ship"
        return
      fi
      if ! website_remote_references_version "$last_ver" >/dev/null 2>&1; then
        echo "resume-site|$last_ver packages/release are live but the website is incomplete — verify the published ISO and resume only the site"
        return
      fi
    fi
    echo "start|No open train — start the next release"
    return
  fi
  local pin_ver pin_rel pin_commit
  pin_ver=$(pin_version "$PIN")
  pin_rel=$(pin_pkgrel "$PIN")
  pin_commit=$(pin_source_commit "$PIN")
  if [[ -z "$PIN" || ! "$pin_ver" =~ ^${TRAIN_VER//./\\.}(rc[0-9]+)?$ ]]; then
    echo "rc|Cut the first candidate for $TRAIN_VER"
  elif [[ "$pin_ver" == "$TRAIN_VER" ]]; then
    echo "ship|Final $TRAIN_VER is pinned — finish shipping (re-runs are safe)"
  elif [[ "$pin_commit" != "$TRAIN_HEAD" ]]; then
    echo "rc|$TRAIN has commits newer than $pin_ver — cut the next candidate"
  elif ! published_version_matches_pin "$RC_VER" "$PIN"; then
    echo "rc|$pin_ver is pinned but not published — re-run rc to re-trigger/wait"
  else
    echo "ship|$pin_ver is published to rc — test it, then ship"
  fi
}

print_status() {
  print_header "Omarchy release status"
  echo "  Channels (omarchy):"
  echo "    edge:   $EDGE_VER"
  echo "    rc:     $RC_VER"
  echo "    stable: $STABLE_VER"
  echo ""
  if [[ -z "$TRAIN" ]]; then
    echo "  No open release train."
  else
    echo "  Open train: $TRAIN_VER (branch $TRAIN @ ${TRAIN_HEAD:0:12})"
    if [[ -n "$PIN" ]]; then
      echo "  Current pin: $(pin_package_version "$PIN") from commit $(pin_source_commit "$PIN")"
    else
      echo "  Current pin: <none>"
    fi
  fi
  echo ""
  local step
  step=$(next_step)
  local display_command="${step%%|*}"
  [[ "$display_command" == resume-site ]] && display_command="ship --resume-site"
  echo "  Next: omarchy-release $display_command  — ${step#*|}"
}

cmd_shepherd() {
  gather_status
  print_status
  local step cmd
  step=$(next_step)
  cmd="${step%%|*}"
  echo ""
  if confirm "Run 'omarchy-release $cmd' now?"; then
    case "$cmd" in
    start) cmd_start ;;
    pick) cmd_pick ;;
    rc) cmd_rc "$ISO_MODE" "$WAIT" ;;
    ship) cmd_ship "$ISO_MODE" "$WAIT" ;;
    resume-site) cmd_ship resume true ;;
    esac
  fi
}

# --- doctor ------------------------------------------------------------------

cmd_doctor() {
  print_header "omarchy-release doctor"
  local failures=0
  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      print_success "$label"
    else
      print_error "$label"
      failures=$((failures + 1))
    fi
  }
  release_config_preflight() { (require_release_config); }
  check "git available" command -v git
  check "release infrastructure configured" release_config_preflight
  check "gh available" command -v gh
  check "gh authenticated" gh auth status
  check "gh can see $UPSTREAM_REPO" gh repo view "$UPSTREAM_REPO"
  check "gh can see $SITE_REPO" gh repo view "$SITE_REPO"
  check "gh can see $ISO_REPO" gh repo view "$ISO_REPO"
  check "ISO release source is exact origin/$ISO_BRANCH" doctor_iso_release_source
  check "1Password CLI available" command -v op
  check "GnuPG available" command -v gpg
  check "rclone available" command -v rclone
  check "ISO destination readable" rclone lsf "$ISO_RCLONE_DEST" --files-only --max-depth 1
  check "ISO signing identity usable" doctor_iso_signing_credentials
  check "ISO destination write/read/delete usable" doctor_iso_publication_credentials
  check "package destination readable on the repository host" doctor_package_destination
  check "vercmp available (pacman)" command -v vercmp
  check "makepkg available (checksums)" command -v makepkg
  check "curl available" command -v curl
  check "upstream reachable ($UPSTREAM_URL)" git ls-remote "$UPSTREAM_URL" HEAD
  local ch
  for ch in edge stable; do
    if published_version "$ch" >/dev/null 2>&1; then
      print_success "$ch channel db readable"
    else
      print_error "$ch channel db readable"
      failures=$((failures + 1))
    fi
  done
  if published_version rc >/dev/null 2>&1; then
    print_success "rc channel db readable"
  else
    print_warning "rc channel db not readable — bootstrap it first: bin/repo bootstrap-rc (on the build host)"
  fi
  local host
  if host=$(repo_host); then
    check "build host ssh ($host)" ssh -o ConnectTimeout=10 "$host" true
  elif on_repo_host; then
    print_success "this machine IS the build host — host operations run locally"
  else
    print_warning "no build host configured — set OMARCHY_REPO_HOST, --host, or write an ssh destination (root@<host> or an ssh-config alias) to $BUILD_ROOT/.repo-host; until then builds trigger on the 6h timer only"
  fi
  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    print_success "docker available (ISO builds possible here)"
  else
    print_warning "docker unavailable — ISO builds will print instructions instead"
  fi
  echo ""
  if ((failures == 0)); then
    print_success "Ready to release"
  else
    print_error "$failures check(s) failed"
    exit 1
  fi
}

# --- self-test ---------------------------------------------------------------

cmd_self_test() {
  local failures=0
  expect() { # expect <label> <got> <want>
    if [[ "$2" == "$3" ]]; then
      echo "  ok: $1"
    else
      echo "  FAIL: $1 — got '$2', want '$3'"
      failures=$((failures + 1))
    fi
  }
  print_header "omarchy-release self-test"
  local current_origin
  current_origin=$(git -C "$BUILD_ROOT" remote get-url origin)
  if (PKGS_ORIGIN="" PKGS_DB_BASE="" SITE_REPO="" ISO_REPO="" ISO_RCLONE_DEST="" PKGS_RCLONE_DEST="" require_release_config) >/dev/null 2>&1; then
    echo "  FAIL: missing release infrastructure accepted"
    failures=$((failures + 1))
  else
    echo "  ok: missing release infrastructure rejected"
  fi
  if (PKGS_ORIGIN="https://packages.example/wrong.git" PKGS_DB_BASE="https://packages.example" SITE_REPO="example/site" ISO_REPO="example/iso" ISO_RCLONE_DEST="example:iso/" PKGS_RCLONE_DEST="example:packages/" require_release_config) >/dev/null 2>&1; then
    echo "  FAIL: mismatched package origin accepted"
    failures=$((failures + 1))
  else
    echo "  ok: mismatched package origin rejected"
  fi
  if (
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0=remote.origin.pushurl
    export GIT_CONFIG_VALUE_0=git@github.com:example/packages.git
    PKGS_ORIGIN=git@github.com:example/packages.git PKGS_DB_BASE="https://packages.example" SITE_REPO="example/site" ISO_REPO="example/iso" ISO_RCLONE_DEST="example:iso/" PKGS_RCLONE_DEST="example:packages/" require_release_config
  ) >/dev/null 2>&1; then
    echo "  ok: explicitly matched release infrastructure accepted"
  else
    echo "  FAIL: explicitly matched release infrastructure rejected"
    failures=$((failures + 1))
  fi
  if (
    export GIT_CONFIG_COUNT=2
    export GIT_CONFIG_KEY_0=remote.origin.pushurl
    export GIT_CONFIG_VALUE_0="$current_origin"
    export GIT_CONFIG_KEY_1=remote.origin.pushurl
    export GIT_CONFIG_VALUE_1=https://github.com/omacom/omarchy-pkgs.git
    PKGS_ORIGIN="$current_origin" PKGS_DB_BASE="https://packages.example" SITE_REPO="example/site" ISO_REPO="example/iso" ISO_RCLONE_DEST="example:iso/" PKGS_RCLONE_DEST="example:packages/" require_release_config
  ) >/dev/null 2>&1; then
    echo "  FAIL: multiple package push destinations accepted"
    failures=$((failures + 1))
  else
    echo "  ok: multiple package push destinations rejected"
  fi
  if (
    PKGS_ORIGIN="$current_origin" PKGS_DB_BASE="https://pkgs.omarchy.org" SITE_REPO="omacom/omarchy.org" ISO_REPO="omacom/omarchy-iso" ISO_RCLONE_DEST="Omarchy:iso.omarchy.org" PKGS_RCLONE_DEST="pkgs.omarchy.org:omarchy-pkgs" require_release_config
  ) >/dev/null 2>&1; then
    echo "  FAIL: explicit upstream release infrastructure accepted"
    failures=$((failures + 1))
  else
    echo "  ok: explicit upstream release infrastructure rejected"
  fi
  if (
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0=remote.origin.pushurl
    export GIT_CONFIG_VALUE_0=https://github.com/OMACOM/OMARCHY-PKGS.git
    PKGS_ORIGIN=https://github.com/OMACOM/OMARCHY-PKGS.git PKGS_DB_BASE="https://PKGS.OMARCHY.ORG" SITE_REPO="Omacom/omarchy.org" ISO_REPO="OMACOM/OMARCHY-ISO" ISO_RCLONE_DEST="example:iso/" PKGS_RCLONE_DEST="example:packages/" require_release_config
  ) >/dev/null 2>&1; then
    echo "  FAIL: mixed-case upstream release infrastructure accepted"
    failures=$((failures + 1))
  else
    echo "  ok: mixed-case upstream release infrastructure rejected"
  fi
  expect "missing package publication destination rejected" \
    "$( (print_error() { :; }; OMARCHY_PKGS_RCLONE_DEST= package_publish_destination) || echo reject)" "reject"
  expect "upstream destination is rejected even when explicit" \
    "$( (print_error() { :; }; package_publish_destination PKGS.OMARCHY.ORG:omarchy-pkgs) || echo reject)" "reject"
  expect "explicit package publication destination accepted" \
    "$(OMARCHY_PKGS_RCLONE_DEST= package_publish_destination Gomarchy:packages/)" "Gomarchy:packages/"
  expect "local package publication path rejected" \
    "$( (print_error() { :; }; package_publish_destination /srv/packages) || echo reject)" "reject"
  expect "historical upstream ISO bucket rejected in isolation" \
    "$( (print_error() { :; }; iso_publish_destination Omarchy:omarchy/) || echo reject)" "reject"
  expect "historical upstream ISO hostname destination rejected in isolation" \
    "$( (print_error() { :; }; iso_publish_destination oMaRcHy:ISO.OMARCHY.ORG/) || echo reject)" "reject"
  expect "explicit Gomarchy ISO destination accepted" \
    "$(iso_publish_destination Gomarchy:iso/)" "Gomarchy:iso/"
  expect "non-canonical GitHub URL rejected" \
    "$(canonical_github_repo https://github.com/example/packages.git/ 2>/dev/null || echo reject)" "reject"
  test_status=0
  (print_warning() { :; }; confirm_package_publication Gomarchy:packages <<<n) >/dev/null 2>&1 || test_status=$?
  expect "declined package publication is incomplete" "$test_status" "3"
  test_status=0
  (print_warning() { :; }; confirm_package_publication Gomarchy:packages <<<y) >/dev/null 2>&1 || test_status=$?
  expect "confirmed package publication proceeds" "$test_status" "0"
  test_status=0
  (rclone() { return 3; }; preflight_package_destination Gomarchy:packages/new) >/dev/null 2>&1 || test_status=$?
  expect "missing first-publication prefix passes remote preflight" "$test_status" "0"
  test_status=0
  (rclone() { return 17; }; preflight_package_destination Gomarchy:packages) >/dev/null 2>&1 || test_status=$?
  expect "package destination credential failure propagates" "$test_status" "17"
  local credentials_fixture
  credentials_fixture=$(mktemp) || exit 1
  printf '%s\n' 'OMARCHY_PKGS_RCLONE_DEST=Gomarchy:packages' >"$credentials_fixture"
  test_status=0
  credentials_file_exports "$credentials_fixture" OMARCHY_PKGS_RCLONE_DEST >/dev/null 2>&1 || test_status=$?
  expect "unexported credentials are invisible to service children" "$test_status" "1"
  printf '%s\n' 'export OMARCHY_PKGS_RCLONE_DEST=Gomarchy:packages' >"$credentials_fixture"
  test_status=0
  credentials_file_exports "$credentials_fixture" OMARCHY_PKGS_RCLONE_DEST >/dev/null 2>&1 || test_status=$?
  expect "exported credentials reach service children" "$test_status" "0"
  rm -f -- "$credentials_fixture"
  expect "version_to_branch 4.0.2" "$(version_to_branch 4.0.2)" "v4-0-2"
  expect "version_to_branch v4.1.0" "$(version_to_branch v4.1.0)" "v4-1-0"
  expect "version_to_branch garbage rejects" "$(version_to_branch 4.0 2>/dev/null || echo reject)" "reject"
  expect "branch_to_version v4-0-2" "$(branch_to_version v4-0-2)" "4.0.2"
  expect "branch_to_version v10-2-33" "$(branch_to_version v10-2-33)" "10.2.33"
  expect "branch_to_version gnome rejects" "$(branch_to_version gnome 2>/dev/null || echo reject)" "reject"
  expect "version_is_patch 4.0.2" "$(version_is_patch 4.0.2 && echo yes || echo no)" "yes"
  expect "version_is_patch 4.1.0" "$(version_is_patch 4.1.0 && echo yes || echo no)" "no"
  expect "version_is_patch 5.0.0" "$(version_is_patch 5.0.0 && echo yes || echo no)" "no"
  expect "previous_patch_tag 4.0.2" "$(previous_patch_tag 4.0.2)" "v4.0.1"
  expect "previous_patch_tag 4.0.10" "$(previous_patch_tag 4.0.10)" "v4.0.9"
  expect "canonical HTTPS repository" "$(canonical_github_repo https://github.com/example/project.git)" "example/project"
  expect "canonical SSH repository" "$(canonical_github_repo git@github.com:example/project.git)" "example/project"
  if release_pin_at_ref HEAD >/dev/null; then
    echo "  ok: current release pins agree"
  else
    echo "  FAIL: current release pins are missing, malformed, or divergent"
    failures=$((failures + 1))
  fi

  local test_status=0
  validate_release_modes rc yes false >/dev/null 2>&1 || test_status=$?
  expect "--no-wait plus --iso rejected" "$test_status" "2"
  test_status=0
  validate_release_modes ship no false >/dev/null 2>&1 || test_status=$?
  expect "--no-wait plus explicit ISO waiver accepted" "$test_status" "0"
  test_status=0
  validate_release_modes status yes true >/dev/null 2>&1 || test_status=$?
  expect "ISO option outside a release command rejected" "$test_status" "2"
  test_status=0
  validate_release_modes rc resume true >/dev/null 2>&1 || test_status=$?
  expect "site resume outside ship rejected" "$test_status" "2"
  test_status=0
  validate_command_args ship 1 >/dev/null 2>&1 || test_status=$?
  expect "unexpected ship argument rejected" "$test_status" "2"

  test_status=0
  (
    resolve_tag_commit() { echo aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa; }
    require_tag_target v4.0.1 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  ) >/dev/null 2>&1 || test_status=$?
  expect "existing tag at pinned commit accepted" "$test_status" "0"
  test_status=0
  (
    resolve_tag_commit() { echo bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; }
    require_tag_target v4.0.1 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  ) >/dev/null 2>&1 || test_status=$?
  expect "existing tag at wrong commit rejected" "$test_status" "1"
  test_status=0
  (
    ls_remote() { return 42; }
    branch_head gnome
  ) >/dev/null 2>&1 || test_status=$?
  expect "branch query failure propagates" "$test_status" "2"
  test_status=0
  (
    ls_remote() { return 42; }
    tag_exists v4.0.1
  ) >/dev/null 2>&1 || test_status=$?
  expect "tag query failure propagates" "$test_status" "2"
  test_status=0
  (
    ls_remote() { return 42; }
    newest_release_branch --untagged
  ) >/dev/null 2>&1 || test_status=$?
  expect "release branch query failure propagates" "$test_status" "2"

  local matching_descs divergent_descs
  matching_descs=$'%FILENAME%\nomarchy-4.0.1-3-any.pkg.tar.zst\n%NAME%\nomarchy\n%VERSION%\n4.0.1-3\n%FILENAME%\nomarchy-settings-4.0.1-3-any.pkg.tar.zst\n%NAME%\nomarchy-settings\n%VERSION%\n4.0.1-3'
  divergent_descs=${matching_descs/omarchy-settings$'\n'%VERSION%$'\n'4.0.1-3/omarchy-settings$'\n'%VERSION%$'\n'4.0.0-9}
  expect "matching published package pair accepted" "$(published_pair_from_descs <<<"$matching_descs")" "4.0.1-3"
  expect "published pkgrel must match the pin" \
    "$(published_version_matches_pin 4.0.1-3 '4.0.1 1 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' && echo yes || echo no)" "no"
  test_status=0
  published_pair_from_descs <<<"$divergent_descs" >/dev/null 2>&1 || test_status=$?
  expect "divergent published package pair rejected" "$test_status" "3"

  test_status=0
  (
    build_iso() { return 23; }
    maybe_iso 4.0.1 final yes
  ) >/dev/null 2>&1 || test_status=$?
  expect "ISO build failure propagates" "$test_status" "23"

  test_status=0
  (
    confirm() { return 1; }
    build_iso() { return 99; }
    maybe_iso 4.0.1 final ask
  ) >/dev/null 2>&1 || test_status=$?
  expect "declined ISO remains incomplete" "$test_status" "3"

  test_status=0
  (
    maybe_iso() { return 23; }
    update_website() { return 99; }
    publish_ship_extras 4.0.1 yes
  ) >/dev/null 2>&1 || test_status=$?
  expect "ISO failure blocks website update" "$test_status" "23"

  test_status=0
  (
    maybe_iso() { ISO_RELEASED=true; return 0; }
    update_website() { return 29; }
    publish_ship_extras 4.0.1 yes
  ) >/dev/null 2>&1 || test_status=$?
  expect "website publication failure propagates" "$test_status" "29"

  test_status=0
  (
    update_website() { return 99; }
    publish_ship_extras 4.0.1 no
  ) >/dev/null 2>&1 || test_status=$?
  expect "explicit ISO waiver skips website" "$test_status" "0"

  test_status=0
  (
    verify_published_iso() { return 0; }
    maybe_iso() { return 99; }
    update_website() { return 0; }
    publish_ship_extras 4.0.1 resume
  ) >/dev/null 2>&1 || test_status=$?
  expect "site resume verifies without rebuilding ISO" "$test_status" "0"

  # Exercise the orchestration boundaries, not only the individual helpers.
  # A call log makes an accidental fall-through into an irreversible step
  # observable without touching a network, repository, or package channel.
  local state_log state_commit=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  state_log=$(mktemp) || exit 1
  test_status=0
  (
    require_release_config() { :; }
    open_train_branch() { echo v4-0-1; }
    branch_head() { echo "$state_commit"; }
    rc_branch_pin() { echo "4.0.1 2 $state_commit"; }
    resolve_tag_commit() { :; }
    published_version() {
      case "$1" in
      rc) echo 4.0.1-3 ;; # same pkgver, wrong pkgrel: still unpublished
      *) echo 4.0.0-1 ;;
      esac
    }
    confirm() { return 0; }
    trigger_rc_build() { echo trigger >>"$state_log"; }
    host_advance() { echo forbidden:promote >>"$state_log"; return 91; }
    ensure_mirror_clone() { echo forbidden:tag >>"$state_log"; return 92; }
    sync_final_pins_to_master() { echo forbidden:master >>"$state_log"; return 93; }
    publish_ship_extras() { echo forbidden:extras >>"$state_log"; return 94; }
    cmd_ship no false
  ) >/dev/null 2>&1 || test_status=$?
  expect "ship --no-wait stops successfully at the build checkpoint" "$test_status" "0"
  expect "ship --no-wait triggers only the exact pkgrel rebuild" "$(cat "$state_log")" "trigger"

  : >"$state_log"
  test_status=0
  (
    require_release_config() { :; }
    open_train_branch() { echo v4-0-1; }
    branch_head() { echo "$state_commit"; }
    rc_branch_pin() { echo "4.0.1 2 $state_commit"; }
    resolve_tag_commit() { echo "$state_commit"; }
    cmd_resume_site() { printf 'resume:%s\n' "$*" >>"$state_log"; }
    confirm() { echo forbidden:confirm >>"$state_log"; return 1; }
    cut_pins() { echo forbidden:pin >>"$state_log"; return 91; }
    trigger_rc_build() { echo forbidden:build >>"$state_log"; return 92; }
    host_advance() { echo forbidden:promote >>"$state_log"; return 93; }
    ensure_mirror_clone() { echo forbidden:tag >>"$state_log"; return 94; }
    sync_final_pins_to_master() { echo forbidden:master >>"$state_log"; return 95; }
    publish_ship_extras() { echo forbidden:extras >>"$state_log"; return 96; }
    cmd_ship resume true
  ) >/dev/null 2>&1 || test_status=$?
  expect "ship --resume-site dispatches successfully" "$test_status" "0"
  expect "ship --resume-site performs no release mutations" "$(cat "$state_log")" \
    "resume:4.0.1 4.0.1 2 $state_commit $state_commit"
  rm -f -- "$state_log"

  local checkout_test_dir
  checkout_test_dir=$(mktemp -d)
  git -C "$checkout_test_dir" init --quiet
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet --allow-empty -m initial
  git -C "$checkout_test_dir" remote add origin https://github.com/example/project.git
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project >/dev/null 2>&1 || test_status=$?
  expect "clean release checkout accepted" "$test_status" "0"
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project write >/dev/null 2>&1 || test_status=$?
  expect "matching release push origin accepted" "$test_status" "0"
  git -C "$checkout_test_dir" remote set-url --push origin https://github.com/example/wrong.git
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project write >/dev/null 2>&1 || test_status=$?
  expect "mismatched release push origin rejected" "$test_status" "1"
  git -C "$checkout_test_dir" remote set-url --push origin https://github.com/example/project.git
  git -C "$checkout_test_dir" remote set-url origin example/project
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project >/dev/null 2>&1 || test_status=$?
  expect "non-GitHub release origin rejected" "$test_status" "1"
  git -C "$checkout_test_dir" remote set-url origin https://github.com/example/project.git

  write_pin_fixture() { # write_pin_fixture <tag> <commit> <version> <rel> <sha> [source]
    local tag="$1" commit="$2" version="$3" rel="$4" sha="$5" source="${6:-pinned}" pkg
    for pkg in omarchy omarchy-settings; do
      mkdir -p "$checkout_test_dir/pkgbuilds/$pkg"
      {
        printf "_tag='%s'\n" "$tag"
        printf "_commit='%s'\n" "$commit"
        printf 'pkgver=%s\n' "$version"
        printf 'pkgrel=%s\n' "$rel"
        printf "pkgname='%s'\n" "$pkg"
        if [[ "$source" == pinned ]]; then
          printf '%s\n' 'source=("https://example.invalid/${_commit}.tar.gz")'
        else
          printf '%s\n' 'source=("https://evil.invalid/unpinned.tar.gz")'
        fi
        printf '%s\n' 'if [[ -n ${OMARCHY_SRC:-} ]]; then'
        printf '%s\n' '  sha256sums=()'
        printf '%s\n' 'else'
        printf "  sha256sums=('%s')\n" "$sha"
        printf '%s\n' 'fi'
      } >"$checkout_test_dir/pkgbuilds/$pkg/PKGBUILD"
    done
  }

  write_pin_fixture v4.0.0 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 4.0.0 3 \
    aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  git -C "$checkout_test_dir" add pkgbuilds
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m baseline-pkgbuilds
  local fixture_master
  fixture_master=$(git -C "$checkout_test_dir" rev-parse HEAD)
  git -C "$checkout_test_dir" update-ref refs/remotes/origin/master "$fixture_master"

  write_pin_fixture v4.0.1 bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb 4.0.1 1 \
    bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
  git -C "$checkout_test_dir" add pkgbuilds
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m exact-pin-scope
  test_status=0
  release_pin_commit_has_exact_scope HEAD "$checkout_test_dir" >/dev/null 2>&1 || test_status=$?
  expect "exact pin commit scope accepted" "$test_status" "0"
  test_status=0
  release_pin_branch_matches_master HEAD "$checkout_test_dir" refs/remotes/origin/master >/dev/null 2>&1 || test_status=$?
  expect "single pin commit on master accepted" "$test_status" "0"
  expect "exact fixture pin accepted" "$(release_pin_at_ref HEAD "$checkout_test_dir")" \
    "4.0.1 1 bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

  write_pin_fixture '' cccccccccccccccccccccccccccccccccccccccc 4.0.2 1 \
    cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc evil
  git -C "$checkout_test_dir" add pkgbuilds
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m malicious-pin-source
  test_status=0
  release_pin_commit_has_exact_scope HEAD "$checkout_test_dir" >/dev/null 2>&1 || test_status=$?
  expect "pin commit source mutation rejected" "$test_status" "1"

  write_pin_fixture '' dddddddddddddddddddddddddddddddddddddddd 4.0.3 1 \
    dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd evil
  git -C "$checkout_test_dir" add pkgbuilds
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m metadata-tip-over-malicious-parent
  test_status=0
  release_pin_commit_has_exact_scope HEAD "$checkout_test_dir" >/dev/null 2>&1 || test_status=$?
  expect "metadata-only tip has valid local scope" "$test_status" "0"
  test_status=0
  release_pin_branch_matches_master HEAD "$checkout_test_dir" refs/remotes/origin/master >/dev/null 2>&1 || test_status=$?
  expect "pin tip with non-master parent rejected" "$test_status" "1"

  printf "_commit='eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee'\n" >>"$checkout_test_dir/pkgbuilds/omarchy/PKGBUILD"
  printf "_commit='eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee'\n" >>"$checkout_test_dir/pkgbuilds/omarchy-settings/PKGBUILD"
  git -C "$checkout_test_dir" add pkgbuilds
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m duplicate-pin-fields
  test_status=0
  release_pin_at_ref HEAD "$checkout_test_dir" >/dev/null 2>&1 || test_status=$?
  expect "duplicate pin assignments rejected" "$test_status" "1"

  printf 'extra\n' >"$checkout_test_dir/extra"
  git -C "$checkout_test_dir" add extra
  git -C "$checkout_test_dir" -c user.name=Gomarchy -c user.email=release-test@example.invalid \
    commit --quiet -m broad-pin-scope
  test_status=0
  release_pin_commit_has_exact_scope HEAD "$checkout_test_dir" >/dev/null 2>&1 || test_status=$?
  expect "broad pin commit scope rejected" "$test_status" "1"

  cp "$checkout_test_dir/.git/index" "$checkout_test_dir/.git/index.valid"
  printf 'invalid-index\n' >"$checkout_test_dir/.git/index"
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project >/dev/null 2>&1 || test_status=$?
  expect "unreadable checkout status rejected" "$test_status" "1"
  mv "$checkout_test_dir/.git/index.valid" "$checkout_test_dir/.git/index"

  printf 'dirty\n' >"$checkout_test_dir/untracked"
  test_status=0
  validate_release_checkout "$checkout_test_dir" example/project >/dev/null 2>&1 || test_status=$?
  expect "dirty release checkout rejected" "$test_status" "1"
  rm -rf -- "$checkout_test_dir"
  echo ""
  if ((failures == 0)); then
    print_success "Self-test passed"
  else
    print_error "$failures self-test failure(s)"
    exit 1
  fi
}

# --- dispatch ----------------------------------------------------------------

COMMAND=""
ISO_MODE="ask"
ISO_MODE_SET=false
WAIT=true
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
  --yes) ASSUME_YES=true; shift ;;
  --host)
    [[ $# -ge 2 && -n "$2" ]] || {
      print_error "--host requires an ssh destination"
      exit 2
    }
    REPO_HOST_OVERRIDE="$2"
    export OMARCHY_REPO_HOST="$2" # child bin/repo invocations forward to it too
    shift 2
    ;;
  --iso | --no-iso | --resume-site)
    requested_iso_mode="yes"
    [[ "$1" == "--no-iso" ]] && requested_iso_mode="no"
    [[ "$1" == "--resume-site" ]] && requested_iso_mode="resume"
    if [[ "$ISO_MODE_SET" == true && "$ISO_MODE" != "$requested_iso_mode" ]]; then
      print_error "--iso, --no-iso, and --resume-site are mutually exclusive"
      exit 2
    fi
    ISO_MODE="$requested_iso_mode"
    ISO_MODE_SET=true
    shift
    ;;
  --no-wait) WAIT=false; shift ;;
  -h | --help) show_usage; exit 0 ;;
  start | pick | rc | ship | status | doctor | self-test)
    if [[ -n "$COMMAND" ]]; then
      print_error "Multiple commands supplied: $COMMAND and $1"
      exit 2
    fi
    COMMAND="$1"; shift ;;
  -*) print_error "Unknown option: $1"; show_usage; exit 2 ;;
  *)
    ARGS+=("$1"); shift ;;
  esac
done

validate_release_modes "$COMMAND" "$ISO_MODE" "$WAIT" || exit $?
validate_command_args "$COMMAND" "${#ARGS[@]}" || exit $?

case "$COMMAND" in
start) cmd_start "${ARGS[@]}" ;;
pick) cmd_pick "${ARGS[@]}" ;;
rc) cmd_rc "$ISO_MODE" "$WAIT" ;;
ship) cmd_ship "$ISO_MODE" "$WAIT" ;;
status) gather_status; print_status ;;
doctor) cmd_doctor ;;
self-test) cmd_self_test ;;
"") cmd_shepherd ;;
*) print_error "Unknown command: $COMMAND"; show_usage; exit 1 ;;
esac
