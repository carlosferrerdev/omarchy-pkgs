#!/bin/bash

unset GPG_PRIVATE_KEY GPG_PASSPHRASE

# Source common functions
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/lock-helpers.sh"
source "$BUILD_ROOT/helpers/publish-helpers.sh"
source "$BUILD_ROOT/helpers/repository-signature-helpers.sh"

REMOTE=""
SKIP_PROD_CHECK=false
PRUNE=false
VERIFY_GNUPGHOME=""
SIGNING_FINGERPRINT=""
TRUST_FINGERPRINT=""
REMOTE_DB_FILE=""
REMOTE_DB_SIGNATURE_FILE=""
LOCAL_INVENTORY_FILE=""
DATABASE_INVENTORY_FILE=""

cleanup() {
  if [[ -n "$VERIFY_GNUPGHOME" && -d "$VERIFY_GNUPGHOME" ]]; then
    gpgconf --homedir "$VERIFY_GNUPGHOME" --kill gpg-agent >/dev/null 2>&1 || true
    rm -rf -- "$VERIFY_GNUPGHOME"
  fi
  [[ -z "$REMOTE_DB_FILE" ]] || rm -f -- "$REMOTE_DB_FILE"
  [[ -z "$REMOTE_DB_SIGNATURE_FILE" ]] || rm -f -- "$REMOTE_DB_SIGNATURE_FILE"
  [[ -z "$LOCAL_INVENTORY_FILE" ]] || rm -f -- "$LOCAL_INVENTORY_FILE"
  [[ -z "$DATABASE_INVENTORY_FILE" ]] || rm -f -- "$DATABASE_INVENTORY_FILE"
}
trap cleanup EXIT

verify_exact_database_signature() {
  local artifact="$1"
  local signature="$2"
  local artifact_real signature_real

  artifact_real=$(realpath "$artifact") || return 1
  signature_real=$(realpath "$signature") || return 1
  repository_signature_verify_exact "$VERIFY_GNUPGHOME" "$SIGNING_FINGERPRINT" \
    "$artifact_real" "$signature_real"
}

prepare_database_verification_keyring() {
  local public_key_file="${OMARCHY_PKGS_SIGNING_PUBLIC_KEY_FILE:-}"

  TRUST_FINGERPRINT=$(repository_signature_normalize_fingerprint \
    OMARCHY_PKGS_TRUST_KEY_FINGERPRINT \
    "${OMARCHY_PKGS_TRUST_KEY_FINGERPRINT:-}") || return 1
  SIGNING_FINGERPRINT=$(repository_signature_normalize_fingerprint \
    OMARCHY_PKGS_SIGNING_KEY_FINGERPRINT \
    "${OMARCHY_PKGS_SIGNING_KEY_FINGERPRINT:-}") || return 1

  VERIFY_GNUPGHOME=$(mktemp -d)
  chmod 0700 "$VERIFY_GNUPGHOME"
  repository_signature_prepare_keyring "$VERIFY_GNUPGHOME" "$public_key_file" \
    "$TRUST_FINGERPRINT" "$SIGNING_FINGERPRINT"
}

validate_local_database_set() {
  local repo_real name resolved
  local -a canonical_names=(
    omarchy.db omarchy.db.tar.zst omarchy.files omarchy.files.tar.zst
    omarchy.db.sig omarchy.db.tar.zst.sig omarchy.files.sig omarchy.files.tar.zst.sig
  )

  repo_real=$(realpath "$REPO_DIR")
  for name in "${canonical_names[@]}"; do
    [[ -L $REPO_DIR/$name && -s $REPO_DIR/$name ]] || {
      print_error "Signed repository database set is missing or unsafe: $REPO_DIR/$name"
      return 1
    }
    resolved=$(realpath "$REPO_DIR/$name") || return 1
    case "$resolved" in
      "$repo_real"/.omarchy-db-generations/*) ;;
      *)
        print_error "Canonical repository database path escapes its immutable generation: $name"
        return 1
        ;;
    esac
  done
  [[ $(realpath "$REPO_DIR/omarchy.db") == $(realpath "$REPO_DIR/omarchy.db.tar.zst") ]] || return 1
  [[ $(realpath "$REPO_DIR/omarchy.db.sig") == $(realpath "$REPO_DIR/omarchy.db.tar.zst.sig") ]] || return 1
  [[ $(realpath "$REPO_DIR/omarchy.files") == $(realpath "$REPO_DIR/omarchy.files.tar.zst") ]] || return 1
  [[ $(realpath "$REPO_DIR/omarchy.files.sig") == $(realpath "$REPO_DIR/omarchy.files.tar.zst.sig") ]] || return 1

  verify_exact_database_signature "$REPO_DIR/omarchy.db" "$REPO_DIR/omarchy.db.sig" || {
    print_error "omarchy.db signature is invalid or does not match $SIGNING_FINGERPRINT"
    return 1
  }
  verify_exact_database_signature "$REPO_DIR/omarchy.db.tar.zst" "$REPO_DIR/omarchy.db.tar.zst.sig" || return 1
  verify_exact_database_signature "$REPO_DIR/omarchy.files" "$REPO_DIR/omarchy.files.sig" || return 1
  verify_exact_database_signature "$REPO_DIR/omarchy.files.tar.zst" "$REPO_DIR/omarchy.files.tar.zst.sig" || return 1
}

validate_local_package_set() {
  local package signature package_count=0

  shopt -s nullglob
  for package in "$REPO_DIR"/*.pkg.tar.*; do
    [[ $package == *.sig ]] && continue
    package_count=$((package_count + 1))
    signature="$package.sig"
    if [[ ! -f $package || -L $package || ! -f $signature || -L $signature ]]; then
      print_error "Repository package or signature is missing, non-regular, or a symlink: ${package##*/}"
      shopt -u nullglob
      return 1
    fi
    if ! verify_exact_database_signature "$package" "$signature"; then
      print_error "Repository package signature is invalid or has an unexpected signer: ${package##*/}"
      shopt -u nullglob
      return 1
    fi
  done
  for signature in "$REPO_DIR"/*.pkg.tar.*.sig; do
    [[ -e $signature || -L $signature ]] || continue
    package=${signature%.sig}
    if [[ ! -f $package || -L $package ]]; then
      print_error "Orphan or unsafe package signature: ${signature##*/}"
      shopt -u nullglob
      return 1
    fi
  done
  shopt -u nullglob

  if [[ $package_count -eq 0 ]]; then
    print_error "Repository contains no regular package artifacts"
    return 1
  fi
}

validate_local_database_inventory() {
  local package package_metadata package_name package_version database_records
  local database_inventory local_names database_names missing_records duplicate_count

  command -v bsdtar >/dev/null 2>&1 || {
    print_error "bsdtar is required to validate repository database inventory"
    return 1
  }

  LOCAL_INVENTORY_FILE=$(mktemp)
  DATABASE_INVENTORY_FILE=$(mktemp)
  shopt -s nullglob
  for package in "$REPO_DIR"/*.pkg.tar.*; do
    [[ $package != *.sig ]] || continue
    if ! package_metadata=$(bsdtar -xOqf "$package" .PKGINFO 2>/dev/null | awk '
      /^pkgname = / { name = substr($0, 11) }
      /^pkgver = / { version = substr($0, 10) }
      END {
        if (name == "" || version == "") exit 1
        print name "\t" version
      }
    '); then
      print_error "Repository package metadata is unreadable: ${package##*/}"
      shopt -u nullglob
      return 1
    fi
    IFS=$'\t' read -r package_name package_version <<<"$package_metadata"
    printf '%s\t%s\t%s\n' "$package_name" "$package_version" "${package##*/}" \
      >>"$LOCAL_INVENTORY_FILE"
  done
  shopt -u nullglob
  sort -u -o "$LOCAL_INVENTORY_FILE" "$LOCAL_INVENTORY_FILE"

  if ! database_records=$(bsdtar -xOf "$REPO_DIR/omarchy.db" --include '*/desc' 2>/dev/null); then
    print_error "Signed repository database inventory could not be read"
    return 1
  fi
  if ! database_inventory=$(printf '%s\n' "$database_records" | awk '
    function emit() {
      if (name == "" && version == "" && filename == "") return
      if (name == "" || version == "" || filename == "") invalid = 1
      else print name "\t" version "\t" filename
      name = version = filename = ""
    }
    $0 == "%NAME%" { getline; name = $0; next }
    $0 == "%VERSION%" { getline; version = $0; next }
    $0 == "%FILENAME%" { emit(); getline; filename = $0; next }
    END { emit(); exit invalid }
  '); then
    print_error "Signed repository database contains an incomplete inventory record"
    return 1
  fi
  printf '%s\n' "$database_inventory" | sort >"$DATABASE_INVENTORY_FILE"
  [[ -s $DATABASE_INVENTORY_FILE ]] || {
    print_error "Signed repository database contains no package inventory"
    return 1
  }

  duplicate_count=$(cut -f1 "$DATABASE_INVENTORY_FILE" | uniq -d | wc -l | tr -d '[:space:]')
  if [[ $duplicate_count -ne 0 ]]; then
    print_error "Signed repository database contains duplicate package names"
    return 1
  fi

  missing_records=$(comm -23 "$DATABASE_INVENTORY_FILE" "$LOCAL_INVENTORY_FILE")
  if [[ -n $missing_records ]]; then
    print_error "Signed repository database names a package version or file absent locally"
    printf '%s\n' "$missing_records" | sed 's/^/  /'
    return 1
  fi

  local_names=$(cut -f1 "$LOCAL_INVENTORY_FILE" | sort -u)
  database_names=$(cut -f1 "$DATABASE_INVENTORY_FILE" | sort -u)
  if [[ $local_names != "$database_names" ]]; then
    print_error "Signed repository database does not match the complete local package inventory"
    print_info "Package names missing from the database:"
    comm -23 <(printf '%s\n' "$local_names") <(printf '%s\n' "$database_names") | sed 's/^/  /'
    print_info "Package names present only in the database:"
    comm -13 <(printf '%s\n' "$local_names") <(printf '%s\n' "$database_names") | sed 's/^/  /'
    return 1
  fi
}

# Print header
print_header "Sync Repository to Remote"

# This script has no `set -e`, so a `shift 2` past the end of the argument list
# fails without consuming anything and the loop spins forever. Check first.
require_value() {
  if [[ $# -lt 2 || -z "$2" ]]; then
    print_error "Option $1 requires a value"
    exit 1
  fi
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch)
    require_value "$@"
    ARCH="$2"
    update_arch_paths
    shift 2
    ;;
  --mirror)
    require_value "$@"
    MIRROR="$2"
    require_valid_mirror "$MIRROR"
    update_arch_paths
    shift 2
    ;;
  --remote)
    require_value "$@"
    REMOTE="$2"
    shift 2
    ;;
  --skip-prod-check)
    SKIP_PROD_CHECK=true
    shift
    ;;
  --prune)
    PRUNE=true
    shift
    ;;
  -h | --help)
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --arch <arch>      Target architecture (x86_64 or aarch64, default: x86_64)"
    echo "  --mirror <mirror>  Mirror to use (edge, rc, or stable, default: edge)"
    echo "  --remote <remote>  Explicit rclone destination (else \$OMARCHY_PKGS_RCLONE_DEST)"
    echo "  --skip-prod-check  Skip publication confirmation"
    echo "  --prune            Also delete remote packages missing locally"
    echo "  -h, --help         Show this help message"
    echo ""
    echo "Uploads are additive by default. Removing packages from the remote"
    echo "requires --prune, which only makes sense from a complete local tree."
    exit 0
    ;;
  *)
    print_error "Unknown option: $1"
    exit 1
    ;;
  esac
done

REMOTE=$(package_publish_destination "$REMOTE") || exit 1

print_info "Mirror: $MIRROR"
print_info "Architecture: $ARCH"
print_info "Local Repository: $REPO_DIR"
print_info "Remote: $REMOTE"
echo ""

# Check if local repo exists
if [[ ! -d "$REPO_DIR" ]]; then
  print_error "Local repository directory not found: $REPO_DIR"
  exit 1
fi

# A manually invoked sync must not publish a legacy unsigned or partially
# signed database. Validate the complete immutable local generation before the
# first rclone call or any package upload.
prepare_database_verification_keyring || exit 1
validate_local_database_set || exit 1
validate_local_package_set || exit 1
validate_local_database_inventory || exit 1

DESTINATION_DIRECTORY="$MIRROR/$ARCH"

# Publishing always deserves confirmation unless the caller explicitly owns
# the non-interactive release workflow. There is no privileged default remote.
if [[ "$SKIP_PROD_CHECK" != true ]]; then
  confirm_package_publication "$REMOTE/$DESTINATION_DIRECTORY" || {
    print_info "Sync cancelled; nothing was published"
    exit 3
  }
fi

acquire_release_lock || exit 1
# The generation may have changed while an operator answered the confirmation
# prompt or while this process waited for the lock. Revalidate under the lock;
# every managed repository mutation uses the same lock.
validate_local_database_set || exit 1
validate_local_package_set || exit 1
validate_local_database_inventory || exit 1

print_info "Syncing to: $REMOTE/$DESTINATION_DIRECTORY"

# The database is what users actually resolve against, and repo-add builds it
# from this tree alone. Publishing one built from a partial tree hides every
# package it does not know about, even though the files are still on the remote.
# Refuse to shrink the package list unless that is the stated intent.
#
# Compare package names, not file counts: this tree keeps several versions of
# each package (bin/repo clean --keep 2) while the database carries one entry per
# name, so counting files would compare unrelated quantities and let a partial
# tree through whenever its spare versions made up the difference.
strip_version() { sed -E 's/-[^-]+-[^-]+-[^-]+\.pkg\.tar\.[^.]+$//'; }

LOCAL_NAMES=$(ls -1 "$REPO_DIR" 2>/dev/null | grep -v '\.sig$' | grep '\.pkg\.tar\.' |
  strip_version | sort -u)

# Distinguish "no repository there yet" from "cannot read the repository". Only
# the first is safe to treat as an empty remote; failing open on a credential or
# network error is how a partial database reaches production.
REMOTE_LISTING=$(rclone lsf "$REMOTE/$DESTINATION_DIRECTORY/" --s3-no-head 2>&1)
RCLONE_STATUS=$?

# rclone exit 3 is "directory not found", which is what a mirror that has never
# been published looks like. Every other failure means the remote could not be
# read, and an unread remote must not be mistaken for an empty one.
if [[ $RCLONE_STATUS -eq 3 ]]; then
  REMOTE_LISTING=""
elif [[ $RCLONE_STATUS -ne 0 ]]; then
  print_error "Cannot read the remote repository (rclone exit $RCLONE_STATUS)"
  echo "$REMOTE_LISTING"
  echo ""
  echo "Refusing to sync: an unreadable remote cannot be checked for packages"
  echo "this tree would hide."
  exit 1
fi

if grep -qx 'omarchy\.db' <<<"$REMOTE_LISTING"; then
  if ! grep -qx 'omarchy\.db\.sig' <<<"$REMOTE_LISTING"; then
    print_error "The remote database exists without its detached signature"
    echo ""
    echo "Refusing to trust an unsigned remote package inventory."
    exit 1
  fi

  # bsdtar, not tar: the database is compressed and GNU tar will not detect that
  # on a pipe. repo-add has used both gzip and zstd, so let libarchive decide.
  REMOTE_DB_FILE=$(mktemp)
  REMOTE_DB_SIGNATURE_FILE=$(mktemp)
  if ! rclone cat "$REMOTE/$DESTINATION_DIRECTORY/omarchy.db" --s3-no-head \
    >"$REMOTE_DB_FILE" 2>/dev/null; then
    print_error "Could not download the remote repository database"
    exit 1
  fi
  if ! rclone cat "$REMOTE/$DESTINATION_DIRECTORY/omarchy.db.sig" --s3-no-head \
    >"$REMOTE_DB_SIGNATURE_FILE" 2>/dev/null; then
    print_error "Could not download the remote repository database signature"
    exit 1
  fi
  if ! verify_exact_database_signature "$REMOTE_DB_FILE" "$REMOTE_DB_SIGNATURE_FILE"; then
    print_error "The remote database signature is invalid or has an unexpected signer"
    echo ""
    echo "Refusing to derive publication policy from unauthenticated remote state."
    exit 1
  fi

  if ! command -v bsdtar >/dev/null 2>&1; then
    print_error "bsdtar is not installed"
    echo ""
    echo "The repository host needs it to read the repository database."
    echo "Run bin/setup to install everything this host requires."
    exit 1
  fi

  # bsdtar, not tar: repo-add has used both gzip and zstd for the database, and
  # libarchive detects either without being told which.
  REMOTE_NAMES=$(bsdtar -tf "$REMOTE_DB_FILE" 2>/dev/null | sed 's|/.*||' |
    sed -E 's/-[^-]+-[^-]+$//' | sort -u)

  if [[ -z "$REMOTE_NAMES" ]]; then
    print_error "The remote database exists but could not be read"
    echo ""
    echo "Refusing to sync rather than assume the remote is empty. Check that"
    echo "omarchy.db is not corrupt:"
    echo "  rclone cat $REMOTE/$DESTINATION_DIRECTORY/omarchy.db | bsdtar -tf -"
    exit 1
  fi

  HIDDEN=$(comm -23 <(echo "$REMOTE_NAMES") <(echo "$LOCAL_NAMES"))
  HIDDEN_COUNT=$(grep -c '' <<<"$HIDDEN")
  [[ -z "$HIDDEN" ]] && HIDDEN_COUNT=0

  if [[ "$HIDDEN_COUNT" -gt 0 && "$PRUNE" != true ]]; then
    print_error "$HIDDEN_COUNT package(s) in the remote database are missing from this tree"
    echo ""
    echo "$HIDDEN" | head -10 | sed 's/^/  /'
    [[ "$HIDDEN_COUNT" -gt 10 ]] && echo "  ... and $((HIDDEN_COUNT - 10)) more"
    echo ""
    echo "Publishing a database built here would hide them, even though their"
    echo "files remain on the mirror."
    echo ""
    echo "To publish packages built on this machine, push them to the build host,"
    echo "which holds the complete repository:"
    echo "  bin/repo push --mirror $MIRROR --arch $ARCH"
    echo ""
    echo "If shrinking the repository is genuinely what you want, pass --prune."
    exit 1
  fi
fi

# Upload packages first, database last, so the remote never advertises a package
# it does not yet have.
#
# This is `copy`, not `sync`: a local tree is not authoritative about what should
# exist on the remote. Packages built on another machine live only in that
# machine's build-output, and pkgs.omarchy.org/ is gitignored, so any checkout
# that has not run a full release is missing nearly everything. `sync` would read
# those absences as deletions and empty the repository. Checksums preserve equal
# objects but repair a corrupted or divergent remote package/signature.
if [[ "$PRUNE" == true ]]; then
  print_warning "Pruning: remote packages missing from $REPO_DIR will be DELETED"
  if [[ "$SKIP_PROD_CHECK" != true ]]; then
    read -p "Prune the remote to match this tree? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      print_info "Sync cancelled"
      exit 0
    fi
  fi
  print_info "Syncing packages (with prune)..."
  if ! rclone sync "$REPO_DIR" "$REMOTE/$DESTINATION_DIRECTORY" \
    --s3-no-head \
    --include "/*.pkg.tar.*" \
    --exclude "*" \
    --checksum \
    --delete-after -v; then
    print_error "Package sync failed — not publishing the database"
    exit 1
  fi
else
  print_info "Syncing packages..."
  if ! rclone copy "$REPO_DIR" "$REMOTE/$DESTINATION_DIRECTORY" \
    --s3-no-head \
    --include "/*.pkg.tar.*" \
    --exclude "*" \
    --checksum \
    -v; then
    print_error "Package upload failed — not publishing the database"
    print_warning "The remote database still describes the previous contents, so"
    print_warning "the repository is unchanged and consistent."
    exit 1
  fi
fi

# Publish signatures before their corresponding artifacts. If any copy fails,
# clients may temporarily reject the mismatched generation, but DatabaseRequired
# ensures they can never accept an unsigned or incorrectly signed database.
# omarchy.db is the pacman entry point and is committed last.
print_info "Updating repository database..."
DATABASE_UPLOAD_ORDER=(
  omarchy.files.tar.zst.sig omarchy.files.sig
  omarchy.files.tar.zst omarchy.files
  omarchy.db.tar.zst.sig omarchy.db.sig
  omarchy.db.tar.zst omarchy.db
)
for database_artifact in "${DATABASE_UPLOAD_ORDER[@]}"; do
  database_source=$(realpath "$REPO_DIR/$database_artifact") || exit 1
  if ! rclone copyto "$database_source" \
    "$REMOTE/$DESTINATION_DIRECTORY/$database_artifact" \
    --s3-no-head --checksum -v; then
    print_error "Database upload failed at $database_artifact"
    print_warning "The remote may reject the in-progress signed generation."
    print_warning "Re-run sync to complete publication; omarchy.db is always last."
    exit 1
  fi
done

print_success "Sync complete!"
