#!/bin/bash
# Upload prebuilt packages: sign → promote → update → sync

set -e

unset GPG_PRIVATE_KEY GPG_PASSPHRASE

SCRIPT_DIR=$(realpath "${BASH_SOURCE[0]%/*}")
BUILD_ROOT=$(realpath "$SCRIPT_DIR/..")
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/lock-helpers.sh"
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/publish-helpers.sh"

# Only sync understands the publishing flags; sign, promote and update reject
# unknown options outright, so they cannot be forwarded blindly.
COMMON_ARGS=()
SYNC_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
  --arch)
    [[ $# -ge 2 && -n $2 ]] || {
      print_error "Option --arch requires a value"
      exit 1
    }
    ARCH="$2"
    update_arch_paths
    COMMON_ARGS+=("$1" "$2")
    shift 2
    ;;
  --mirror)
    [[ $# -ge 2 && -n $2 ]] || {
      print_error "Option --mirror requires a value"
      exit 1
    }
    MIRROR="$2"
    update_arch_paths
    COMMON_ARGS+=("$1" "$2")
    shift 2
    ;;
  --skip-prod-check | --prune)
    SYNC_ARGS+=("$1")
    shift
    ;;
  --remote)
    [[ $# -ge 2 && -n $2 ]] || {
      print_error "Option --remote requires a value"
      exit 1
    }
    SYNC_ARGS+=("$1" "$2")
    shift 2
    ;;
  *)
    COMMON_ARGS+=("$1")
    shift
    ;;
  esac
done
explicit_remote=""
for ((i=0; i<${#SYNC_ARGS[@]}; i++)); do
  if [[ ${SYNC_ARGS[$i]} == --remote ]]; then
    explicit_remote=${SYNC_ARGS[$((i + 1))]:-}
  fi
done
publish_destination=$(package_publish_destination "$explicit_remote") || exit 1
if [[ -z $explicit_remote ]]; then
  SYNC_ARGS+=(--remote "$publish_destination")
fi
if [[ " ${SYNC_ARGS[*]} " != *" --skip-prod-check "* ]]; then
  confirm_package_publication "$publish_destination" "the prebuilt package set" || {
    print_info "Upload cancelled before signing or promotion"
    exit 3
  }
  SYNC_ARGS+=(--skip-prod-check)
fi
preflight_package_destination "$publish_destination" || exit $?

acquire_release_lock || exit 1

"$SCRIPT_DIR/repo" sign "${COMMON_ARGS[@]}"
"$SCRIPT_DIR/repo" promote "${COMMON_ARGS[@]}"
"$SCRIPT_DIR/repo" update "${COMMON_ARGS[@]}"
"$SCRIPT_DIR/repo" sync "${COMMON_ARGS[@]}" "${SYNC_ARGS[@]}"
